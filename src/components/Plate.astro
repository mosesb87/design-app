---
// A plate: one real capture in a rounded frame, with a provenance line.
// Without a capture it renders a designed typographic plate (never an empty box).
import Picture from './Picture.astro';
import { view as getView, capturedDate, domain } from '../lib/media';
interface Props {
  slug?: string;
  v?: 'desktop-hero' | 'desktop-full' | 'mobile-hero' | 'mobile-full' | 'tablet-hero';
  alt: string;
  title?: string;
  url?: string;
  meta?: string[];
  plate?: string; // "Plate 04"
  sizes?: string;
  eager?: boolean;
  aspect?: string; // crop to aspect (e.g. "16 / 10"); default = capture aspect
  caption?: boolean;
  vtTarget?: boolean;
  vtHero?: boolean;
  staticReveal?: boolean;
  class?: string;
}
const {
  slug, v = 'desktop-hero', alt, title = '', url, meta = [], plate, sizes = '(min-width: 1024px) 66vw, 100vw',
  eager = false, aspect, caption = true, vtTarget = false, vtHero = false, staticReveal = false, class: cls = '',
} = Astro.props;
const d = getView(slug, v);
const date = capturedDate(slug);
const ratio = aspect || (d ? `${d.w} / ${Math.min(d.h, Math.round(d.w * 0.625))}` : '16 / 10');
---
<figure class:list={['plate', cls, { 'plate--empty': !d }]} data-plate data-plate-static={staticReveal || eager ? '' : undefined}>
  <div class="plate__frame crop" style={`aspect-ratio: ${ratio}`} data-vt-target={vtTarget ? '' : undefined} data-vt-hero={vtHero ? '' : undefined}>
    {d ? (
      <>
        <Picture data={d} alt={alt} sizes={sizes} eager={eager} fetchpriority={eager ? 'high' : undefined} class="plate__img" />
      </>
    ) : (
      <div class="plate__type plate__img" role="img" aria-label={alt}>
        <span class="plate__type-title">{title}</span>
        <span class="plate__type-url slug">{domain(url)}</span>
      </div>
    )}
    <span class="crop__b" aria-hidden="true"></span>
  </div>
  {caption && (
    <figcaption class="plate__slug slug slug-list">
      {plate && <span>{plate}</span>}
      {url && <span>{domain(url)}</span>}
      {meta.map((x) => <span>{x}</span>)}
      {date ? <span>Captured {date}</span> : <span>Capture pending</span>}
    </figcaption>
  )}
</figure>

<style>
  .plate { position: relative; margin: 0; }
  .plate__frame { position: relative; overflow: visible; background: var(--paper-2); }
  .plate__frame > :global(picture), .plate__frame > .plate__type { position: absolute; inset: 0; overflow: hidden; }
  .plate__frame :global(picture img) { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .plate__ghost {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    mix-blend-mode: multiply;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }
  .plate__slug { margin-top: var(--s-4); }
  .plate__type {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(16px, 3vw, 40px);
    background:
      repeating-linear-gradient(0deg, transparent 0 23px, color-mix(in srgb, var(--rule) 55%, transparent) 23px 24px),
      var(--paper-2);
  }
  .plate__type-title {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 115%;
    font-size: clamp(1.75rem, 5vw, 4.5rem);
    line-height: 0.92;
    letter-spacing: -0.035em;
    max-width: 12ch;
  }
  [data-ground='night'] .plate__frame, :global([data-ground='night']) .plate__frame { background: var(--night-2); }
</style>
