---
// S6 — Counted, not claimed. Six reviews, each led by its number (true value in the HTML).
import Plate from '../Plate.astro';
import VideoPlate from '../VideoPlate.astro';
import { media } from '../../lib/media';
import { reviews, reviewsIndexUrl, formatDate } from '../../data/site';
---
<section class="counted section" id="reviews" aria-labelledby="counted-title">
  <div class="wrap">
    <header class="counted__head">
      <p class="kicker">Independent reviews</p>
      <h2 class="counted__title h2 reg" id="counted-title" data-text="Counted, not claimed." data-register>Counted, not claimed.</h2>
      <p class="counted__sub">I read a company’s website the way a shopper, a crawler and an AI answer engine do — public pages only, every finding dated — and build a working fix alongside. Each one leads with the number that explains the rest.</p>
    </header>
    <ol class="counted__list" role="list">
      {reviews.map((r, i) => (
        <li class="review" data-count-host>
          <p class="review__num num" data-count style={`--chars: ${r.number.length}`}>{r.number}</p>
          <div class="review__body">
            <p class="review__label">{r.numberLabel}</p>
            <p class="slug slug-list review__src" data-count-after>
              <span>{r.site}</span>
              <span>{formatDate(r.date)}</span>
              <span>{r.focus}</span>
            </p>
            <h3 class="review__title" data-count-after>{r.title}</h3>
            <p class="review__fix" data-count-after><span class="slug">Fix built · </span>{r.fix}</p>
            <a class="link-arrow review__link" href={r.url} rel="noopener">Read the review <span class="visually-hidden">of {r.title}</span><span class="arrow" aria-hidden="true">↗</span></a>
          </div>
          <div class="review__plate">
            {media(r.media)?.interaction ? (
              <VideoPlate slug={r.media} kind="interact" label={`Screen recording of the fix built for the ${r.title} review`} caption="The fix, in use" />
            ) : (
              <Plate slug={r.media} alt={`The ${r.title} review page`} title={r.title} url={r.url} caption={false} sizes="(min-width: 1024px) 22vw, 90vw" aspect="16 / 10" />
            )}
          </div>
        </li>
      ))}
    </ol>
    <p class="counted__more">
      <a class="btn btn--line" href={reviewsIndexUrl} rel="noopener">All reviews on the reviews index <span class="arrow" aria-hidden="true">↗</span></a>
    </p>
  </div>
</section>

<style>
  .counted__head { display: grid; gap: var(--s-4); margin-bottom: var(--s-8); }
  .counted__title { max-width: 14ch; }
  .counted__sub { color: var(--fg-2); max-width: 56ch; }
  .review {
    container-type: inline-size;
    --num-col: 100cqi;
    display: grid;
    gap: var(--s-4);
    padding-block: var(--s-6);
    border-top: 1px solid var(--line);
  }
  .counted__list .review:last-child { border-bottom: 1px solid var(--line); }
  .review__num {
    font-family: var(--font-display);
    font-weight: 840;
    font-stretch: 96%;
    /* Long figures ("$9.50 / $18.99") shrink to fit their column; short ones keep the full size. */
    font-size: min(var(--t-number), calc(var(--num-col) / (var(--chars, 4) * 0.49)));
    line-height: 1;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }
  .review__num :global(.odo) { display: inline-block; height: 1em; overflow: hidden; vertical-align: top; }
  .review__num :global(.odo__strip) { display: block; }
  .review__num :global(.odo__strip > span) { display: block; height: 1em; line-height: 1; }
  .review__label { font-size: var(--t-lead); line-height: 1.3; font-weight: 500; max-width: 26ch; letter-spacing: -0.01em; }
  .review__src { margin-top: var(--s-3); }
  .review__title { font-family: var(--font-display); font-weight: 740; font-stretch: 106%; font-size: var(--t-h3); margin-top: var(--s-4); }
  .review__fix { color: var(--fg-2); max-width: 46ch; margin-top: 4px; }
  .review__link { margin-top: var(--s-4); min-height: 44px; }
  .review__plate { max-width: 420px; }
  .counted__more { margin-top: var(--s-7); }

  @media (min-width: 1024px) {
    .counted__head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .counted__head > * { grid-column: 1 / span 7; }
    .review { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; --num-col: calc(41.6cqi - 1.6 * var(--gutter)); }
    .review__num { grid-column: 1 / span 5; }
    .review__body { grid-column: 6 / span 4; padding-top: 0.6em; }
    .review__plate { grid-column: 10 / span 3; padding-top: 0.8em; max-width: none; }
  }
</style>
