---
import { person, layers } from '../../data/site';
---
<section class="thesis" id="thesis" data-thesis aria-labelledby="thesis-title">
  <div class="thesis__track">
    <div class="thesis__sticky">
      <div class="wrap thesis__grid">
        <header class="thesis__copy">
          <p class="kicker">How I think</p>
          <h2 class="thesis__title" id="thesis-title">
            <span class="thesis__title-a" data-title-a>{person.thesis.lead}</span>
            <span class="thesis__title-b" data-title-b aria-hidden="true">Every build I make starts at that seam.</span>
          </h2>
          <p class="thesis__body">{person.thesis.body}</p>
        </header>

        <ol class="thesis__steps" role="list" data-steps>
          {layers.map((l, i) => (
            <li class="thesis__step" data-step={i}>
              <p class="slug">{l.n} · {l.name}</p>
              <p class="thesis__step-title">{l.title}</p>
              <p class="thesis__step-text"><span>{l.example}</span></p>
            </li>
          ))}
          <li class="thesis__step" data-step="3">
            <p class="slug">04 · The seam</p>
            <p class="thesis__step-title">Checked before a customer sees it</p>
            <p class="thesis__step-text"><span>{person.thesis.close}</span></p>
          </li>
        </ol>

        <div class="thesis__stage" aria-hidden="true">
          <div class="stage" data-stage>
            <div class="card card--shelf-ghost"></div>
            <div class="card card--sheet" data-card="sheet">
              <p class="card__head"><span>01 · The sheet</span><span>What was asked</span></p>
              <div class="card__table">
                <span>Promo</span><span>Reg</span><span>Off</span>
                <b>$19.20</b><b class="card__stale" data-stale>$24.00</b><b>20%</b>
              </div>
              <p class="card__status card__status--ok" data-sheet-ok>20% of $24.00 = $19.20 · matches</p>
              <p class="card__stamp card__stamp--red" data-stamp-fail>✕ Check 04 fails</p>
              <span class="card__scan" data-scan></span>
            </div>
            <div class="card card--register" data-card="register">
              <p class="card__head"><span>02 · The register</span><span>What the system holds</span></p>
              <dl class="card__kv">
                <div><dt>Reg price</dt><dd data-reg-price>$25.60</dd></div>
                <div><dt>Vendor cap</dt><dd>20%</dd></div>
                <div><dt>Margin floor</dt><dd>32%</dd></div>
              </dl>
              <p class="card__status card__status--flag" data-reg-flag>Sheet price is stale</p>
              <span class="card__scan" data-scan></span>
            </div>
            <div class="card card--shelf" data-card="shelf">
              <p class="card__head"><span>03 · The shelf</span><span>What the customer sees</span></p>
              <div class="card__tile" data-tile-live>
                <span class="card__badge">20% off</span>
                <span class="card__price">$19.20</span>
                <span class="card__name">Promotion</span>
              </div>
              <div class="card__tile card__tile--held" data-tile-held>
                <span class="card__held">Blocked before a menu</span>
                <span class="card__owner">Owner: pricing team · reason written in plain words</span>
              </div>
              <span class="card__scan" data-scan></span>
            </div>
          </div>
          <p class="thesis__verdict" data-verdict><span>✓</span> Nothing wrong reached the shelf</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .thesis { position: relative; }
  .thesis__sticky { padding-block: var(--section); }
  .thesis__grid { display: grid; gap: var(--s-7); }
  .thesis__copy { display: grid; gap: var(--s-5); align-content: start; }
  .thesis__title {
    font-family: var(--font-display);
    font-size: var(--t-h2);
    font-weight: 780;
    font-stretch: 104%;
    line-height: 0.96;
    letter-spacing: -0.03em;
    text-wrap: balance;
    display: grid;
  }
  .thesis__title > span { grid-area: 1 / 1; }
  .thesis__title-b { visibility: hidden; }
  .thesis__body { max-width: 48ch; color: var(--fg-2); text-wrap: pretty; }
  .thesis__steps { display: grid; gap: var(--s-5); }
  .thesis__step { border-top: 1px solid var(--line); padding-top: var(--s-3); transition: opacity var(--d-small) var(--ease-drift); }
  .thesis__step-title { font-family: var(--font-display); font-weight: 720; font-stretch: 104%; font-size: var(--t-h3); line-height: 1.1; margin-top: 4px; }
  .thesis__step-text { margin-top: 6px; color: var(--fg-2); max-width: 46ch; font-size: var(--t-small); line-height: 1.5; }

  /* Stage — the default (no JS / reduced motion) is the exploded, fully annotated state */
  .thesis__stage { position: relative; display: grid; place-items: center; min-height: 460px; }
  .stage {
    --w: min(78vw, 360px);
    position: relative;
    width: var(--w);
    height: calc(var(--w) * 0.62);
    transform-style: preserve-3d;
    transform: perspective(1400px) rotateX(52deg) rotateZ(-32deg);
  }
  .card {
    position: absolute;
    inset: 0;
    padding: 14px 16px;
    background: #fbfaf6;
    border: 1px solid var(--rule);
    box-shadow: 0 1px 0 rgb(0 0 0 / 0.04), 0 18px 30px -18px rgb(20 20 20 / 0.28);
    font-size: 12px;
    line-height: 1.35;
    overflow: hidden;
    backface-visibility: hidden;
  }
  .card--sheet { transform: translateZ(210px); border-top: 3px solid var(--sheet); background: repeating-linear-gradient(0deg, transparent 0 21px, rgb(207 201 187 / 0.55) 21px 22px), #fbfaf6; }
  .card--register { transform: translateZ(105px); border-top: 3px solid var(--register); background: var(--night); color: var(--night-ink); border-color: var(--night-rule); }
  .card--register .card__head { color: var(--night-ink-2); }
  .card--register .card__kv div { border-bottom-color: var(--night-rule); }
  .card--register .card__kv dt { color: var(--night-ink-2); }
  .card--register .card__status--flag { color: var(--sheet-light); }
  .card--shelf { transform: translateZ(0); border-top: 3px solid var(--ink); }
  .card--shelf-ghost { transform: translateZ(-2px); background: var(--paper-3); border: 0; box-shadow: none; opacity: 0.5; }
  .card__head { display: flex; justify-content: space-between; gap: 8px; font: 500 10px/1.2 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-2); margin-bottom: 10px; }
  .card__table { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2px 8px; font-family: var(--font-mono); font-size: 11px; }
  .card__table span { color: var(--ink-2); border-bottom: 1px solid var(--rule); padding-bottom: 3px; }
  .card__table b { font-weight: 600; font-size: 15px; padding-top: 4px; font-variant-numeric: tabular-nums; }
  .card__stale { position: relative; color: var(--sheet-text); }
  .card__stale::after { content: ''; position: absolute; left: -2px; right: -2px; top: 58%; height: 2px; background: var(--sheet); transform-origin: left; }
  .card__status { margin-top: 10px; font: 500 10.5px/1.3 var(--font-mono); }
  .card__status--ok { color: var(--check); }
  .card__status--flag { color: var(--sheet-text); }
  .card__stamp { position: absolute; right: 12px; bottom: 12px; font: 700 10px/1 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; padding: 6px 8px; border: 1.5px solid currentColor; transform: rotate(-4deg); }
  .card__stamp--red { color: var(--sheet-text); }
  .card__kv { display: grid; gap: 4px; font-family: var(--font-mono); font-size: 11px; }
  .card__kv div { display: flex; justify-content: space-between; border-bottom: 1px dashed var(--rule); padding-bottom: 3px; }
  .card__kv dt { color: var(--ink-2); }
  .card__kv dd { margin: 0; font-weight: 600; font-variant-numeric: tabular-nums; }
  .card__tile { position: absolute; left: 16px; right: 16px; bottom: 14px; top: 42px; display: grid; align-content: end; gap: 2px; padding: 12px; background: var(--paper-2); }
  .card__tile--held { background: var(--sheet-ground); color: #fbf8f2; align-content: center; }
  .card__badge { justify-self: start; font: 700 10px/1 var(--font-mono); background: var(--sheet); color: #fff; padding: 4px 6px; letter-spacing: 0.04em; }
  .card__price { font-family: var(--font-display); font-weight: 820; font-size: 28px; line-height: 1; letter-spacing: -0.02em; font-variant-numeric: tabular-nums; }
  .card__name { font-size: 11px; color: var(--ink-2); }
  .card__held { font-family: var(--font-display); font-weight: 760; font-size: 17px; line-height: 1.1; }
  .card__owner { font: 500 10px/1.35 var(--font-mono); color: #fbe3dc; letter-spacing: 0.02em; }
  .card__scan { position: absolute; top: 0; bottom: 0; left: 0; width: 2px; background: var(--sheet); box-shadow: 0 0 0 1px rgb(226 61 40 / 0.18); opacity: 0; }
  .card--shelf .card__tile:not(.card__tile--held) { display: none; }
  .thesis__verdict {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%) rotate(-2deg);
    white-space: nowrap;
    font: 700 var(--t-slug) / 1 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--check);
    border: 1.5px solid currentColor;
    padding: 9px 12px;
    background: var(--bg);
  }

  @media (min-width: 1024px) {
    .thesis__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: var(--s-6); }
    .thesis__copy { grid-column: 1 / span 5; }
    .thesis__steps { grid-column: 1 / span 4; }
    .thesis__stage { grid-column: 6 / span 7; grid-row: 1 / span 2; min-height: 620px; }
    .stage { --w: min(34vw, 520px); }
    .card { padding: 18px 20px; font-size: 13px; }
    .card__head { font-size: 11px; }
    .card__table b { font-size: 19px; }
    .card__kv { font-size: 12.5px; }
    .card__price { font-size: 38px; }
    .card__held { font-size: 22px; }
    .card--sheet { transform: translateZ(300px); }
    .card--register { transform: translateZ(150px); }
  }

  /* ── Motion: sticky stage driven by one progress value (runtime adds .motion-ok) */
  :global(.motion-ok) .thesis__track { height: 330vh; }
  :global(.motion-ok) .thesis__sticky { position: sticky; top: 0; height: 100svh; padding-block: calc(var(--nav-h) + 12px) var(--s-5); overflow: hidden; display: flex; align-items: center; }
  :global(.motion-ok) .thesis__sticky > .wrap { width: 100%; }
  :global(.motion-ok) .thesis__title-b { visibility: visible; opacity: 0; }
  :global(.motion-ok) .card--shelf .card__tile:not(.card__tile--held) { display: grid; }
  :global(.motion-ok) .card--shelf .card__tile--held,
  :global(.motion-ok) .card__stamp,
  :global(.motion-ok) .card__status--flag,
  :global(.motion-ok) .thesis__verdict { opacity: 0; }
  :global(.motion-ok) .card__stale::after { transform: scaleX(0); transition: transform var(--d-small) var(--ease-register); }
  :global(.motion-ok) .card__stale.is-struck::after { transform: scaleX(1); }
  :global(.motion-ok) .thesis__step { opacity: 0.32; }
  :global(.motion-ok) .thesis__step.is-active { opacity: 1; }

  @media (min-width: 1024px) {
    :global(.motion-ok) .thesis__title { font-size: clamp(2rem, 3.3vw, 3.6rem); }
    :global(.motion-ok) .thesis__steps { gap: 0; }
    :global(.motion-ok) .thesis__step { padding-block: 10px; }
    :global(.motion-ok) .thesis__step-title { font-size: clamp(1.1rem, 1.5vw, 1.4rem); }
    :global(.motion-ok) .thesis__step-text { display: grid; grid-template-rows: 0fr; transition: grid-template-rows var(--d-small) var(--ease-register); overflow: hidden; margin-top: 0; }
    :global(.motion-ok) .thesis__step-text > span { min-height: 0; overflow: hidden; }
    :global(.motion-ok) .thesis__step.is-active .thesis__step-text { grid-template-rows: 1fr; margin-top: 6px; }
  }
  @media (min-width: 1024px) and (max-height: 820px) {
    :global(.motion-ok) .thesis__body { display: none; }
  }
  @media (max-width: 1023px) {
    :global(.motion-ok) .thesis__track { height: 280vh; }
    :global(.motion-ok) .thesis__grid { grid-template-rows: auto 1fr auto; height: calc(100svh - var(--nav-h) - 40px); gap: var(--s-4); }
    :global(.motion-ok) .thesis__body { display: none; }
    :global(.motion-ok) .thesis__title { font-size: clamp(1.75rem, 7vw, 2.75rem); }
    :global(.motion-ok) .thesis__stage { min-height: 0; grid-row: 2; }
    :global(.motion-ok) .thesis__steps { grid-row: 3; display: grid; }
    :global(.motion-ok) .thesis__step { grid-area: 1 / 1; opacity: 0; border-top: 0; padding-top: 0; }
    :global(.motion-ok) .thesis__step.is-active { opacity: 1; }
    :global(.motion-ok) .thesis__step-title { font-size: 1.2rem; }
    .stage { --w: min(72vw, 340px); }
    .card--sheet { transform: translateZ(200px); }
    .card--register { transform: translateZ(100px); }
  }
</style>
