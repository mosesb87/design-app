---
// S8 — What I do, specifically: six services as a calm spec sheet.
import { services } from '../../data/site';
---
<section class="spec section" aria-labelledby="spec-title">
  <div class="wrap">
    <header class="spec__head">
      <p class="kicker">Services</p>
      <h2 class="spec__title h2 reg" id="spec-title" data-text="Start with the business goal. End with the measurement." data-register>Start with the business goal. End with the measurement.</h2>
      <p class="spec__sub">I start with the goal, understand the data and the customer path, then build, test, measure and improve. The result stays useful after launch — not just attractive on day one.</p>
    </header>
    <ol class="spec__list" role="list" data-rows>
      {services.map((s) => (
        <li class="spec__row">
          <span class="spec__n slug">{s.n}</span>
          <h3 class="spec__name">{s.title}</h3>
          <p class="spec__text">{s.text}</p>
          <ul class="spec__tools slug" role="list">{s.tools.map((t) => <li>{t}</li>)}</ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .spec__head { display: grid; gap: var(--s-4); margin-bottom: var(--s-8); }
  .spec__title { max-width: 18ch; }
  .spec__sub { color: var(--fg-2); max-width: 52ch; }
  .spec__row { display: grid; grid-template-columns: 2.5em 1fr; gap: 6px var(--s-4); padding-block: var(--s-5); border-top: 1px solid var(--line); }
  .spec__list .spec__row:last-child { border-bottom: 1px solid var(--line); }
  .spec__n { grid-row: span 3; padding-top: 0.4em; }
  .spec__name { font-family: var(--font-display); font-weight: 760; font-stretch: 108%; font-size: var(--t-h3); line-height: 1.1; }
  .spec__text { color: var(--fg-2); max-width: 52ch; }
  .spec__tools { display: flex; flex-wrap: wrap; gap: 4px 14px; color: var(--fg); }
  @media (min-width: 1024px) {
    .spec__head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .spec__head > * { grid-column: 1 / span 8; }
    .spec__row { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: baseline; }
    .spec__n { grid-column: 1; grid-row: auto; padding-top: 0; }
    .spec__name { grid-column: 2 / span 4; }
    .spec__text { grid-column: 6 / span 4; }
    .spec__tools { grid-column: 10 / span 3; }
  }
</style>
