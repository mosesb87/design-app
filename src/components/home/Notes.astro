---
// S9 — Notes: six articles from the blog, linking to their WordPress posts.
import { posts, blogUrl, formatDate } from '../../data/site';
---
<section class="notes section section--tight" aria-labelledby="notes-title">
  <div class="wrap">
    <header class="notes__head">
      <p class="kicker">Notes</p>
      <h2 class="notes__title h2" id="notes-title">Notes from running stores.</h2>
    </header>
    <ul class="notes__list" role="list" data-rows>
      {posts.map((p) => (
        <li>
          <a class="note" href={p.url} rel="noopener">
            <time class="slug num" datetime={p.date}>{formatDate(p.date)}</time>
            <span class="note__title">{p.title}</span>
            <span class="slug note__topic">{p.topic}</span>
            <span class="note__arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="notes__more"><a class="link-arrow" href={blogUrl} rel="noopener">All notes on the blog <span class="arrow" aria-hidden="true">↗</span></a></p>
  </div>
</section>

<style>
  .notes__head { margin-bottom: var(--s-7); display: grid; gap: var(--s-4); }
  .notes__list li { border-top: 1px solid var(--line); }
  .notes__list li:last-child { border-bottom: 1px solid var(--line); }
  .note { display: grid; grid-template-columns: 1fr auto; gap: 6px var(--s-4); padding-block: var(--s-5); text-decoration: none; }
  .note .slug:first-child { grid-column: 1 / -1; }
  .note__title { font-family: var(--font-display); font-weight: 720; font-stretch: 104%; font-size: var(--t-h3); line-height: 1.15; transition: font-stretch var(--d-small) var(--ease-register); }
  .note__topic { grid-column: 1; }
  .note__arrow { grid-row: 2; grid-column: 2; align-self: start; transition: transform var(--d-small) var(--ease-register), color var(--d-micro); }
  .note:hover .note__title { font-stretch: 110%; }
  .note:hover .note__arrow, .note:focus-visible .note__arrow { transform: translate(3px, -3px); color: var(--sheet); }
  .notes__more { margin-top: var(--s-6); }
  @media (min-width: 1024px) {
    .note { grid-template-columns: 11em minmax(0, 1fr) 14em 2em; align-items: baseline; }
    .note .slug:first-child { grid-column: auto; }
    .note__topic { grid-column: auto; }
    .note__arrow { grid-row: auto; grid-column: auto; }
  }
</style>
