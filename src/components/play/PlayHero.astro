---
// Hero: the name, huge and condensed, beside Mousa's photo standing in a cobalt panel (his head breaks the
// panel's top edge). Letters fly in from scattered spots and hop when touched; the photo leans with the
// pointer, turns from black-and-white to color and extends on hover, and shrinks and extends with scroll;
// colorful icon tiles float, sway and lean around it. (Motion: scripts/motion/play-hero.ts, photoflex.ts.)
import Sticker from './Sticker.astro';
import { person } from '../../data/site';
const rows = [person.first.toUpperCase(), person.last.toUpperCase()];
const stickers = [
  { name: 'tag', cls: 's-tag', depth: 0.9 },
  { name: 'cell', cls: 's-cell', depth: 0.6 },
  { name: 'check', cls: 's-check', depth: 1.1 },
  { name: 'cursor', cls: 's-cursor', depth: 0.8 },
  { name: 'chart', cls: 's-chart', depth: 1.2 },
  { name: 'heart', cls: 's-heart', depth: 0.5 },
] as const;
const src = (w: number, f: string) => `/media/me/mousa-${w}.${f}`;
---
<section class="ph" data-play-hero aria-labelledby="hero-title">
  <div class="ph__inner wrap">
    <div class="ph__text">
      <p class="kicker ph__kicker" data-ph-fade>{person.title} · {person.location} · {person.availability.toLowerCase()}</p>
      <h1 class="ph__name" id="hero-title">
        <span class="visually-hidden">{person.name}</span>
        {rows.map((w, r) => (
          <span class:list={['ph__row', `ph__row--${r + 1}`]} aria-hidden="true">
            {[...w].map((ch, i) => <span class="ph__l" data-l>{ch}</span>)}
          </span>
        ))}
      </h1>
      <div class="ph__bottom">
        <p class="ph__intro" data-ph-fade>I find what’s costing an online store sales — and ship the <strong>fix</strong>, with the <strong>check</strong> that keeps it fixed.</p>
        <div class="ph__cta" data-ph-fade>
          <a class="btn" href="#work">See the work <span class="arrow" aria-hidden="true">→</span></a>
          <a class="btn btn--line" href="#contact">Say hello</a>
        </div>
      </div>
    </div>
    <figure class="ph__me" data-ph-me data-photo-flex="hero">
      <div class="ph__panel" aria-hidden="true" data-flex-panel><span class="ph__grid"></span></div>
      <picture class="ph__photo" data-ph-photo data-flex-photo>
        <source type="image/avif" srcset={`${src(480, 'avif')} 480w, ${src(800, 'avif')} 800w, ${src(1200, 'avif')} 1200w`} sizes="(min-width: 1024px) 34vw, (min-width: 700px) 56vw, 88vw" />
        <source type="image/webp" srcset={`${src(480, 'webp')} 480w, ${src(800, 'webp')} 800w, ${src(1200, 'webp')} 1200w`} sizes="(min-width: 1024px) 34vw, (min-width: 700px) 56vw, 88vw" />
        <img src={src(800, 'webp')} width="1200" height="1219" alt="Mousa Batarseh, smiling, arms crossed" fetchpriority="high" decoding="async" />
      </picture>
      <figcaption class="ph__cap" data-ph-fade><span>Mousa Batarseh</span><span>Webmaster · WordPress & e-commerce</span></figcaption>
      <div class="ph__stickers" aria-hidden="true">
        {stickers.map((s) => (
          <span class:list={['ph__s', s.cls]} data-ph-sticker data-depth={s.depth}>
            <Sticker name={s.name} depth={s.depth} />
          </span>
        ))}
      </div>
    </figure>
  </div>
</section>

<style>
  .ph {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(40px, 5.5vw, 96px));
    padding-bottom: clamp(72px, 8vw, 136px);
    overflow: clip;
    display: flex;
  }
  .ph__inner { position: relative; display: grid; gap: var(--s-7); width: 100%; align-content: end; }
  .ph__text { position: relative; z-index: 2; display: flex; flex-direction: column; gap: clamp(28px, 3.4vw, 56px); container-type: inline-size; min-width: 0; }
  .ph__kicker { position: relative; z-index: 2; }
  .ph__name {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 75%;
    line-height: 0.8;
    letter-spacing: -0.012em;
    /* BATARSEH fills its column (it measures ~3.6em at this width and weight), without pushing the intro
       below the fold on short screens. */
    font-size: min(calc(100cqi / 3.62), calc((100svh - 300px) / 1.62), 27rem);
    user-select: none;
  }
  .ph__row { display: block; white-space: nowrap; }
  .ph__row--2 { margin-top: 0.02em; }
  .ph__l { display: inline-block; transition: color 0.4s var(--ease-register); }
  .ph__l.is-hot { transition-duration: 0.05s; }
  .ph__bottom { position: relative; z-index: 2; display: grid; gap: clamp(24px, 2.6vw, 40px); align-items: end; }
  .ph__intro { font-size: var(--t-lead); line-height: 1.3; max-width: 30ch; font-weight: 450; letter-spacing: -0.01em; }
  .ph__intro strong { font-weight: 650; background: linear-gradient(transparent 64%, var(--accent-tint-2) 0); }
  .ph__cta { display: flex; flex-wrap: wrap; gap: var(--s-3); }

  /* The photo: a cobalt panel with a fine grid; the cut-out stands on its bottom edge and breaks its top. */
  .ph__me { position: relative; margin: 0; width: min(88vw, 440px); justify-self: end; aspect-ratio: 1 / 1.08; }
  .ph__panel {
    position: absolute;
    inset: 16% 0 0 0;
    border-radius: var(--r-xl);
    background: radial-gradient(120% 90% at 30% 10%, #3f5ff0 0%, var(--accent) 38%, var(--accent-deep) 100%);
    overflow: hidden;
    box-shadow: var(--shadow-2);
  }
  .ph__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgb(255 255 255 / 0.1) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.1) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: radial-gradient(90% 80% at 50% 30%, #000 20%, transparent 85%);
  }
  .ph__photo { position: absolute; left: 0; right: 0; bottom: 0; display: block; }
  /* The panel's shape clips the photo at the sides and bottom; above the panel the head is free. */
  .ph__photo { clip-path: inset(-60% 0 0 0 round var(--r-xl)); }
  .ph__photo img { width: 100%; height: auto; transition: filter 0.9s var(--ease-register); }
  @media (hover: hover) and (pointer: fine) {
    .ph__photo img { filter: grayscale(1) contrast(1.06); }
    .ph__me:hover .ph__photo img { filter: none; }
    /* Pointing at the photo extends it: the panel and the cut-out grow a little (on top of the scroll's size). */
    .ph__panel, .ph__photo { transition: scale 0.8s var(--ease-register); }
    .ph__me:hover .ph__panel { scale: 1.05; }
    .ph__me:hover .ph__photo { scale: 1.07; }
  }
  .ph__cap {
    position: absolute;
    left: 14px;
    bottom: 14px;
    z-index: 3;
    display: grid;
    gap: 2px;
    padding: 10px 14px;
    border-radius: var(--r-m);
    background: rgb(255 255 255 / 0.9);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: var(--shadow-1);
    font: 650 0.8125rem / 1.25 var(--font-text);
  }
  .ph__cap span + span { font-weight: 500; color: var(--ink-2); }
  .ph__stickers { position: absolute; inset: 0; z-index: 4; pointer-events: none; }
  .ph__s { position: absolute; display: block; pointer-events: auto; }
  .ph__s :global(.sticker) { --size: 100%; width: 100%; }
  /* Colored tiles around the photo: sky, green, night and violet. */
  .ph .s-tag :global(.sticker) { --tile: var(--blue-soft); --stroke: var(--ink); --acc: var(--accent-deep); box-shadow: 0 20px 36px -18px rgb(43 77 224 / 0.55); }
  .ph .s-check :global(.sticker) { --tile: var(--night); --stroke: #fff; --acc: var(--accent-soft); }
  .ph .s-cursor :global(.sticker) { --tile: var(--red); --stroke: #fff; --acc: var(--red-soft); background: linear-gradient(150deg, #ff5a60, var(--red) 60%); box-shadow: 0 18px 32px -18px rgb(232 35 46 / 0.6); }
  .ph .s-cell :global(.sticker) { --tile: var(--leaf); --stroke: var(--ink); --acc: var(--accent-deep); }
  .ph .s-chart :global(.sticker) { --tile: #fff; --stroke: var(--ink); --acc: var(--accent); box-shadow: 0 18px 32px -18px rgb(14 17 22 / 0.4); }
  .ph .s-heart :global(.sticker) { --tile: var(--red); --stroke: #fff; --acc: var(--red-soft); background: linear-gradient(150deg, #ff5a60, var(--red) 60%); box-shadow: 0 18px 32px -18px rgb(232 35 46 / 0.6); }
  /* Tiles sit on the panel's right edge and over the photo's lower corners, never over the name.
     Phones: two tiles; more from tablet up. */
  .s-tag { width: 88px; top: 6%; right: -3%; }
  .s-check { width: 56px; bottom: 30%; left: 4%; }
  .s-cell, .s-cursor, .s-chart, .s-heart { display: none; }
  @media (min-width: 700px) {
    .ph__bottom { grid-template-columns: 1fr auto; }
    .ph__me { width: min(56vw, 460px); margin-top: calc(var(--s-7) * -1); }
    .s-cell { display: block; width: 104px; top: 48%; right: -8%; }
  }
  @media (min-width: 1024px) {
    .ph__inner { grid-template-columns: minmax(0, 1.72fr) minmax(0, 1fr); column-gap: clamp(24px, 3vw, 56px); align-items: end; }
    .ph__bottom { grid-template-columns: 1fr; }
    .ph__me { width: 100%; max-width: 520px; margin-top: 0; aspect-ratio: 1 / 1.12; }
    .s-tag { width: 118px; top: 8%; right: -7%; }
    .s-cell { width: 120px; top: 46%; right: -9%; }
    .s-check { width: 64px; bottom: 34%; left: 5%; }
    .s-cursor { display: block; width: 58px; bottom: 7%; right: 6%; }
    .s-chart { display: block; width: 62px; top: 21%; left: 4%; }
    .s-heart { display: block; width: 46px; top: 1%; left: 16%; }
  }
  @media (min-width: 1280px) {
    .ph__bottom { grid-template-columns: 1fr auto; }
  }
</style>
