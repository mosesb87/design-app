---
// "Each one leads with the number that explains the rest." — six reviews, each with its first screen, its
// number and what that number counts. Every card opens that review's page on this site.
import ReviewCard from '../ReviewCard.astro';
import { reviews } from '../../data/site';
import { allReviews } from '../../data/reviews';
import Ghost from '../Ghost.astro';
---
<section class="revs section has-ghost" id="reviews" aria-labelledby="revs-title">
  <Ghost text="Reviews" align="left" top="1%" />
  <div class="wrap">
    <header class="revs__head">
      <p class="kicker">Independent reviews</p>
      <h2 class="h2 h2--long revs__title" id="revs-title">Each one leads with the number<br class="br-wide" /> that explains the rest.</h2>
      <p class="revs__sub">I read a company’s website the way a shopper, a crawler and an AI answer engine do — public pages only, every finding dated — and build a working fix alongside.</p>
    </header>
    <ul class="revs__grid" role="list" data-pop-grid>
      {reviews.map((r) => (
        <li data-pop><ReviewCard slug={r.slug} number={r.number} label={r.numberLabel} /></li>
      ))}
    </ul>
    <p class="revs__more"><a class="btn" href="/reviews/">All {allReviews.length} reviews <span class="arrow" aria-hidden="true">→</span></a></p>
  </div>
</section>

<style>
  .revs__head { display: grid; gap: var(--s-4); margin-bottom: var(--s-8); }
  .revs__head .h2 { max-width: 24ch; }
  .revs__sub { max-width: 52ch; color: var(--fg-2); font-size: var(--t-lead); line-height: 1.3; }
  .revs__grid { display: grid; gap: clamp(48px, 4vw, 64px) clamp(16px, 1.8vw, 28px); }
  .revs__more { margin-top: var(--s-8); display: flex; justify-content: center; }
  @media (min-width: 700px) { .revs__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 1100px) { .revs__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
