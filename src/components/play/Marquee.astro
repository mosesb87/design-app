---
// A tilted band of what Mousa works with, running across the page. The list is read once by screen readers.
interface Props { items: string[]; tone?: 'lime' | 'pink' | 'sun' | 'violet'; tilt?: number; reverse?: boolean; label?: string }
const { items, tone = 'lime', tilt = -2, reverse = false, label = 'What I work with' } = Astro.props;
const run = [...items, ...items];
---
<div class:list={['mq', `mq--${tone}`, { 'mq--rev': reverse }]} style={`--tilt:${tilt}deg`} data-marquee>
  <p class="visually-hidden">{label}: {items.join(', ')}.</p>
  <div class="mq__track" aria-hidden="true">
    {[0, 1].map(() => (
      <div class="mq__run">
        {run.map((t) => (<span class="mq__item">{t}<i class="mq__star">✦</i></span>))}
      </div>
    ))}
  </div>
</div>

<style>
  .mq {
    position: relative;
    z-index: 4;
    margin-inline: -2vw;
    padding-block: clamp(14px, 1.6vw, 22px);
    transform: rotate(var(--tilt));
    overflow: hidden;
    box-shadow: var(--shadow-1);
  }
  .mq--lime { background: var(--lime); color: var(--ink); }
  .mq--pink { background: var(--pink); color: var(--ink); }
  .mq--sun { background: var(--sun); color: var(--ink); }
  .mq--violet { background: var(--violet); color: #fff; }
  .mq__track { display: flex; width: max-content; animation: mq 38s linear infinite; }
  .mq--rev .mq__track { animation-direction: reverse; }
  .mq__run { display: flex; flex: none; }
  .mq__item {
    display: inline-flex;
    align-items: center;
    gap: clamp(16px, 2vw, 32px);
    padding-right: clamp(16px, 2vw, 32px);
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 75%;
    font-size: clamp(1.75rem, 3.6vw, 3.25rem);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .mq__star { font-style: normal; font-size: 0.6em; display: inline-block; animation: mq-spin 6s linear infinite; }
  @keyframes mq { to { transform: translateX(-50%); } }
  @keyframes mq-spin { to { transform: rotate(360deg); } }
  .mq:hover .mq__track { animation-play-state: paused; }
  @media (prefers-reduced-motion: reduce) {
    .mq__track, .mq__star { animation: none; }
  }
</style>
