---
// Inner-page header in the home page's language: a condensed title, one size on every page, whose letters fly in
// from scattered spots and settle (and hop when touched), and colorful icon tiles that float, sway, lean towards
// the pointer and wiggle when touched — the page's own three, plus three more on desktop (unless an aside takes
// the right side). The same motion module as the home hero (play-hero.ts). Optional tone turns the header into a
// colored room.
import Sticker from './Sticker.astro';
import type { StickerName } from './types';
interface Props {
  title: string;
  kicker?: string;
  dot?: string;
  lead?: string;
  tone?: string; // a color token, e.g. 'var(--lilac)'
  stickers?: StickerName[];
  size?: 'xl' | 'l' | 'm' | 's';
  id?: string;
  breakAfter?: number; // set the title on two lines from tablet up: break after this many words
}
const { title, kicker, lead, tone, stickers = [], size = 'xl', id = 'page-title', breakAfter } = Astro.props;
const words = title.toUpperCase().split(/\s+/);
const tilts = [-9, 11, -5, 7, -12, 9];
const hasAside = Astro.slots.has('aside');
const depths = [0.9, 0.6, 1.2, 0.7, 1.1, 0.5];
// Three more tiles for desktop, picked from a pool so a page never shows the same icon twice.
const pool: StickerName[] = ['chart', 'bag', 'fx', 'code', 'cursor', 'spark', 'check', 'heart', 'tag', 'cell'];
const own = stickers.slice(0, 3);
const extras = own.length && !hasAside ? pool.filter((n) => !own.includes(n)).slice(0, 3) : [];
const tiles = [...own, ...extras];
---
<header class:list={['phd', `phd--${size}`, { 'phd--room': !!tone, 'phd--aside': hasAside, 'phd--lines': !!breakAfter }]} style={tone ? `--bg:${tone}` : undefined} data-play-hero>
  <div class="wrap phd__inner">
    <slot name="top" />
    {kicker && <p class="kicker phd__kicker" data-ph-fade>{kicker}</p>}
    <h1 class="phd__title" id={id}>
      <span class="visually-hidden">{title}</span>
      <span aria-hidden="true">
        {words.map((w, i) => (
          <>
            <span class="phd__w">{[...w].map((ch) => <span class="phd__l" data-l>{ch}</span>)}</span>{i < words.length - 1 && (breakAfter === i + 1 ? <><br class="phd__br" /> </> : ' ')}
          </>
        ))}
      </span>
    </h1>
    {lead && <p class="phd__lead" data-ph-fade>{lead}</p>}
    <slot />
    {hasAside && <div class="phd__aside"><slot name="aside" /></div>}
  </div>
  {tiles.length > 0 && (
    <div class="phd__stickers" aria-hidden="true">
      {tiles.map((s, i) => (
        <span class:list={['phd__s', `phd__s--${i + 1}`]} data-ph-sticker data-depth={depths[i]}>
          <Sticker name={s} tilt={tilts[i]} />
        </span>
      ))}
    </div>
  )}
</header>

<style>
  .phd { position: relative; overflow: clip; padding-top: calc(var(--nav-h) + var(--s-8)); padding-bottom: var(--s-6); }
  .phd--room {
    background: var(--bg);
    color: var(--ink);
    margin-inline: clamp(8px, 1.4vw, 24px);
    border-radius: 0 0 var(--r-xl) var(--r-xl);
    --fg: var(--ink);
    --fg-2: var(--ink-2);
  }
  .phd__inner { position: relative; z-index: 1; display: grid; gap: var(--s-5); }
  .phd__kicker { justify-self: start; }
  .phd--room .phd__kicker { background: rgb(255 255 255 / 0.72); }
  .phd__title {
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 75%;
    line-height: 0.84;
    letter-spacing: -0.005em;
    text-wrap: balance;
    max-width: 11ch;
    user-select: none;
  }
  /* One size for every page title (the same as a blog post's); long titles simply take more lines. */
  .phd__title { font-size: clamp(3rem, 7.2vw, 7.5rem); max-width: 16ch; line-height: 0.88; }
  .phd--s .phd__title { max-width: 20ch; }
  .phd__w { display: inline-block; white-space: nowrap; }
  .phd__br { display: none; }
  @media (min-width: 700px) { .phd--lines .phd__title { max-width: none; } .phd__br { display: inline; } }
  .phd__l { display: inline-block; transition: color 0.4s var(--ease-register); }
  .phd__l.is-hot { transition-duration: 0.05s; }
  .phd__lead { font-size: var(--t-lead); line-height: 1.32; max-width: 40ch; color: var(--fg-2); font-weight: 450; text-wrap: pretty; }
  .phd__stickers { position: absolute; inset: 0; z-index: 2; pointer-events: none; }
  .phd__s { position: absolute; display: block; pointer-events: auto; cursor: grab; }
  .phd__s :global(.sticker) { --size: 100%; width: 100%; }
  /* Colored tiles with a light-to-deep gradient: cobalt, the logo's green, deep cobalt into night. */
  .phd .phd__s--1 :global(.sticker) { --tile: var(--accent); --stroke: #fff; --acc: var(--blue-pale); background: linear-gradient(150deg, #4d6bff, var(--accent) 45%, var(--accent-deep)); box-shadow: 0 22px 40px -22px rgb(28 51 168 / 0.75); }
  .phd .phd__s--2 :global(.sticker) { --tile: var(--leaf); --stroke: var(--ink); --acc: var(--accent-deep); background: linear-gradient(150deg, var(--leaf-soft), var(--leaf) 60%); box-shadow: 0 18px 32px -18px rgb(90 160 0 / 0.55); }
  .phd .phd__s--3 :global(.sticker) { --tile: var(--night); --stroke: #fff; --acc: var(--accent-soft); background: linear-gradient(150deg, var(--accent-deep), var(--night) 70%); box-shadow: 0 20px 36px -20px rgb(13 16 21 / 0.7); }
  .phd__s--1 { width: clamp(84px, 13vw, 210px); right: var(--margin); top: calc(var(--nav-h) + 28px); }
  .phd__s--2 { width: clamp(44px, 5.5vw, 88px); right: calc(var(--margin) + clamp(96px, 15vw, 250px)); top: calc(var(--nav-h) + 12px); }
  /* The desktop extras: violet, pale sky and the one red tile (red is kept to a few icons site-wide). */
  .phd .phd__s--4 :global(.sticker) { --tile: var(--iris); --stroke: var(--ink); --acc: var(--accent-deep); background: linear-gradient(150deg, #c7bdff, var(--iris) 55%, #8a76f5); box-shadow: 0 20px 36px -20px rgb(91 63 214 / 0.6); }
  .phd .phd__s--5 :global(.sticker) { --tile: var(--blue-soft); --stroke: var(--ink); --acc: var(--accent-deep); background: linear-gradient(150deg, var(--blue-pale), var(--blue-soft) 60%); box-shadow: 0 18px 32px -18px rgb(43 77 224 / 0.5); }
  .phd .phd__s--6 :global(.sticker) { --tile: var(--red); --stroke: #fff; --acc: var(--red-soft); background: linear-gradient(150deg, #ff5a60, var(--red) 60%); box-shadow: 0 18px 32px -18px rgb(232 35 46 / 0.6); }
  .phd__s--3, .phd__s--4, .phd__s--5, .phd__s--6 { display: none; }
  /* Desktop: all six sit in the upper right, measured from the top, so they stay beside the title and never
     reach the cards some pages put below it (the archive's counts, a case study's facts). */
  @media (min-width: 1024px) {
    .phd__s--3 { display: block; width: clamp(90px, 8vw, 130px); right: calc(var(--margin) + 4vw); top: calc(var(--nav-h) + clamp(250px, 20vw, 300px)); }
    .phd__s--4 { display: block; width: clamp(58px, 5vw, 84px); right: calc(var(--margin) + clamp(210px, 22vw, 340px)); top: calc(var(--nav-h) + clamp(150px, 13vw, 200px)); }
    .phd__s--5 { display: block; width: clamp(44px, 3.8vw, 62px); right: calc(var(--margin) + clamp(150px, 15vw, 240px)); top: calc(var(--nav-h) + clamp(230px, 18vw, 280px)); }
    .phd__s--6 { display: block; width: clamp(40px, 3.4vw, 56px); right: calc(var(--margin) - 8px); top: calc(var(--nav-h) + clamp(250px, 19vw, 300px)); }
  }
  @media (max-width: 699px) {
    .phd__s--1 { top: calc(var(--nav-h) + 8px); }
    .phd__s--2 { top: calc(var(--nav-h) + 4px); }
  }
  /* With an aside (e.g. the review checks): title and lead on the left, the aside on the right from desktop up. */
  .phd__aside { position: relative; z-index: 0; margin-top: var(--s-5); }
  /* The aside's cards scatter past the header's lower edge: clip only the sides. */
  .phd--aside { overflow: visible; overflow-x: clip; }
  .phd--aside .phd__title, .phd--aside .phd__lead, .phd--aside .phd__kicker { position: relative; z-index: 2; }
  @media (min-width: 1024px) {
    .phd--aside .phd__inner { grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr); column-gap: clamp(32px, 4vw, 72px); align-items: center; }
    .phd--aside .phd__inner > :not(.phd__aside) { grid-column: 1; }
    .phd--aside .phd__aside { grid-column: 2; grid-row: 1 / span 6; margin-top: 0; }
  }
</style>
