---
// The contact finale on every page: "Put yours in place." — a plain black room whose title letters fly in from
// every direction and settle as it comes up the screen (scatter again when scrolled back, and scatter a little
// when pointed at), colored icon tiles that scatter in with the scroll, float, lean towards the pointer and
// scatter a little when the photo is pointed at, Mousa standing in a cobalt panel that
// shrinks and extends with scroll (desktop), the email big enough to tap, one-click copy, and the other ways to
// reach him. (Motion: scripts/motion/fly.ts, tiles.ts, photoflex.ts; copy behaviour: contact.ts.)
import Sticker from './play/Sticker.astro';
import type { StickerName } from './play/types';
import { person } from '../data/site';
interface Props { heading?: string }
const { heading } = Astro.props;
const lines = heading ? [heading] : ['Put yours', 'in place.'];
const tiles: { name: StickerName; tilt: number; depth: number }[] = [
  { name: 'heart', tilt: -6, depth: 0.9 },
  { name: 'spark', tilt: 10, depth: 0.5 },
  { name: 'check', tilt: 8, depth: 1.1 },
  { name: 'cursor', tilt: -6, depth: 0.8 },
  { name: 'chart', tilt: 7, depth: 0.6 },
  { name: 'bag', tilt: -9, depth: 1.2 },
  { name: 'fx', tilt: 5, depth: 0.7 },
  { name: 'code', tilt: -4, depth: 1 },
];
const src = (w: number, f: string) => `/media/me/mousa-${w}.${f}`;
---
<section class="finale" id="contact" data-ground="night" aria-labelledby="contact-title" data-contact>
  <div class="finale__room" data-tiles>
    <div class="wrap finale__inner">
      <div class="finale__text">
        <p class="kicker finale__kicker">Contact</p>
        <h2 class="finale__title" id="contact-title" data-fly="in" data-cluster-edge>
          <span class="visually-hidden">{lines.join(' ')}</span>
          <span aria-hidden="true">
            {lines.map((line) => (
              <span class="finale__line">
                {line.split(/\s+/).map((w, i, all) => (
                  <><span class="finale__w">{[...w].map((ch) => <span class="finale__l" data-fl>{ch}</span>)}</span>{i < all.length - 1 && ' '}</>
                ))}
              </span>
            ))}
          </span>
        </h2>
        <p class="finale__sub" data-cluster-edge>{person.contactLine} {person.contactSub}</p>

        <div class="finale__email-row">
          <a class="finale__email" href={`mailto:${person.email}`} data-email>{person.email}</a>
          <div class="finale__actions">
            <button class="btn btn--bright finale__copy" type="button" data-copy={person.email}>
              <span data-copy-label>Copy email</span>
            </button>
            <span class="finale__stamp" role="status" aria-live="polite" data-copy-status></span>
          </div>
        </div>

        <dl class="finale__ledger">
          <div><dt>Phone</dt><dd><a href={person.phoneHref}>{person.phoneDisplay}</a></dd></div>
          <div><dt>LinkedIn</dt><dd><a href={person.linkedin} rel="noopener">{person.linkedinLabel} <span aria-hidden="true">↗</span></a></dd></div>
          <div><dt>Based in</dt><dd>{person.location} · {person.region}</dd></div>
        </dl>
      </div>
      <figure class="finale__me" data-photo-flex="end">
        <div class="finale__panel" aria-hidden="true" data-flex-panel><span class="finale__grid"></span></div>
        <picture class="finale__photo" data-flex-photo>
          <source type="image/avif" srcset={`${src(480, 'avif')} 480w, ${src(800, 'avif')} 800w`} sizes="(min-width: 1024px) 24vw, 1px" />
          <source type="image/webp" srcset={`${src(480, 'webp')} 480w, ${src(800, 'webp')} 800w`} sizes="(min-width: 1024px) 24vw, 1px" />
          <img src={src(480, 'webp')} width="1200" height="1219" alt="Mousa Batarseh" loading="lazy" decoding="async" />
        </picture>
      </figure>
    </div>
    <div class="finale__cluster" aria-hidden="true" data-tile-cluster>
      {tiles.map((t, i) => (
        <span class:list={['finale__s', `finale__s--${i + 1}`]} data-tile data-depth={t.depth}><Sticker name={t.name} tilt={t.tilt} /></span>
      ))}
    </div>
  </div>
</section>

<style>
  .finale { padding: var(--s-8) clamp(8px, 1.4vw, 24px) 0; }
  .finale__room {
    position: relative;
    overflow: clip;
    border-radius: var(--r-xl);
    background: var(--night);
    color: #fff;
    padding-block: clamp(36px, 4.4vw, 64px) clamp(22px, 2.4vw, 32px);
  }
  .finale__inner { position: relative; z-index: 2; display: grid; gap: var(--s-6); }
  .finale__text { display: grid; gap: var(--s-3); min-width: 0; }
  .finale__kicker { justify-self: start; background: rgb(255 255 255 / 0.1); color: #fff; }
  .finale__title { font-family: var(--font-display); font-weight: 900; font-stretch: 75%; font-size: var(--t-h2); line-height: 0.86; text-transform: uppercase; max-width: 12ch; user-select: none; }
  .finale__line { display: block; }
  .finale__w { display: inline-block; white-space: nowrap; }
  /* The letters only move, never change color: a pointer over the heading scatters them a little and they
     settle back (motion/fly.ts + base.css). */
  .finale__l { display: inline-block; }
  .finale__sub { font-size: var(--t-lead); line-height: 1.3; max-width: 36ch; color: var(--night-ink-2); font-weight: 500; }
  .finale__email-row { container-type: inline-size; display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4) var(--s-5); margin-top: var(--s-4); }
  .finale__email {
    justify-self: start;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 80%;
    font-size: min(clamp(1.35rem, 2.7vw, 2.5rem), calc(100cqi / 12.6));
    line-height: 1.1;
    padding-block: 6px;
    color: #fff;
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .finale__copy { --btn-bg: #fff; --btn-fg: var(--ink); }
  .finale__actions { display: flex; align-items: center; gap: var(--s-5); flex-wrap: wrap; }
  .finale__stamp:empty { display: none; }
  .finale__stamp { display: inline-block; padding: 10px 16px; border-radius: var(--r-pill); background: var(--accent); color: #fff; font: 750 0.9375rem/1 var(--font-text); }
  .finale__ledger {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 10px var(--gutter);
    margin-top: var(--s-3);
  }
  .finale__ledger div { padding: 10px 14px; border-radius: var(--r-m); background: rgb(255 255 255 / 0.06); transition: background-color var(--d-small), translate 0.4s var(--ease-register); }
  .finale__ledger div:hover { background: rgb(255 255 255 / 0.12); translate: 0 -3px; }
  .finale__ledger dt { font: 700 var(--t-slug) / 1.3 var(--font-text); letter-spacing: 0.06em; text-transform: uppercase; color: #fff; margin-bottom: 6px; }
  .finale__ledger dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; color: #fff; }
  .finale__ledger a { color: #fff; text-decoration-color: color-mix(in srgb, #fff 45%, transparent); }
  .finale__ledger a:hover { color: #fff; text-decoration-color: #fff; }

  /* Mousa in a cobalt panel (desktop): his head breaks the panel's top edge, as in the hero. */
  .finale__me { display: none; position: relative; margin: 0; aspect-ratio: 1 / 1.08; align-self: end; }
  .finale__panel {
    position: absolute;
    inset: 16% 0 0 0;
    border-radius: var(--r-xl);
    background: radial-gradient(120% 90% at 30% 10%, #3f5ff0 0%, var(--accent) 38%, var(--accent-deep) 100%);
    overflow: hidden;
  }
  .finale__grid {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(rgb(255 255 255 / 0.1) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.1) 1px, transparent 1px);
    background-size: 24px 24px;
    mask-image: radial-gradient(90% 80% at 50% 30%, #000 20%, transparent 85%);
  }
  .finale__photo { position: absolute; left: 0; right: 0; bottom: 0; display: block; clip-path: inset(-60% 0 0 0 round var(--r-xl)); }
  .finale__photo img { width: 100%; height: auto; }
  @media (hover: hover) and (pointer: fine) {
    .finale__panel, .finale__photo { transition: scale 0.8s var(--ease-register); }
    .finale__me:hover .finale__panel { scale: 1.06; }
    .finale__me:hover .finale__photo { scale: 1.08; }
  }
  @media (min-width: 1024px) {
    .finale__inner { grid-template-columns: minmax(0, 1fr) clamp(280px, 25vw, 380px); column-gap: clamp(32px, 4vw, 80px); align-items: end; }
    .finale__me { display: block; }
  }

  /* Colored icon tiles on the black room. Each floats on its own rhythm (the CSS translate, so the pointer lean
     from tiles.ts adds to it) and wiggles when touched (hover.css). */
  .finale__cluster { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .finale__s { position: absolute; pointer-events: none; animation: finale-bob 3.4s ease-in-out infinite alternate; }
  .finale__s :global(.sticker) { --size: 100%; width: 100%; }
  .finale .finale__s--1 :global(.sticker) { --tile: var(--accent); --stroke: #fff; --acc: var(--blue-pale); background: linear-gradient(150deg, #4d6bff, var(--accent) 45%, var(--accent-deep)); box-shadow: 0 18px 36px -16px rgb(43 77 224 / 0.7); }
  .finale .finale__s--2 :global(.sticker) { --tile: var(--leaf); --stroke: var(--ink); --acc: var(--accent-deep); background: linear-gradient(150deg, var(--leaf-soft), var(--leaf) 60%); }
  .finale .finale__s--3 :global(.sticker) { --tile: #fff; --stroke: var(--ink); --acc: var(--accent); }
  .finale .finale__s--4 :global(.sticker) { --tile: var(--red); --stroke: #fff; --acc: var(--red-soft); background: linear-gradient(150deg, #ff5a60, var(--red) 55%); box-shadow: 0 18px 36px -16px rgb(232 35 46 / 0.6); }
  .finale .finale__s--5 :global(.sticker) { --tile: var(--blue-soft); --stroke: var(--ink); --acc: var(--accent-deep); background: linear-gradient(150deg, var(--blue-pale), var(--blue-soft) 60%); }
  .finale .finale__s--6 :global(.sticker) { --tile: var(--leaf-soft); --stroke: var(--ink); --acc: var(--accent); }
  .finale .finale__s--7 :global(.sticker) { --tile: var(--red); --stroke: #fff; --acc: var(--red-soft); background: linear-gradient(150deg, #ff5a60, var(--red) 55%); box-shadow: 0 18px 36px -16px rgb(232 35 46 / 0.6); }
  .finale .finale__s--8 :global(.sticker) { --tile: var(--blue-pale); --stroke: var(--ink); --acc: var(--accent); }
  .finale__s--1 { width: clamp(48px, 5vw, 80px); right: 6%; top: 8%; }
  .finale__s--2 { width: clamp(36px, 3.4vw, 54px); right: 22%; top: 6%; animation-delay: -1.2s; }
  .finale__s--6 { width: clamp(30px, 3vw, 48px); right: 12%; top: 19%; animation-delay: -2.6s; animation-duration: 2.8s; }
  .finale__s--3, .finale__s--4, .finale__s--5, .finale__s--7, .finale__s--8 { display: none; }
  @media (min-width: 700px) {
    .finale__s--5 { display: block; width: clamp(48px, 5vw, 72px); right: 9%; top: 30%; animation-delay: -1.8s; animation-duration: 4s; }
    .finale__s--7 { display: block; width: clamp(38px, 4vw, 56px); right: 30%; top: 16%; animation-delay: -0.4s; animation-duration: 3.8s; }
  }
  /* Desktop: the tiles come together as a tidy grid — four across, two rows, all one size — in the open space
     beside Mousa's head: its top edge level with the top of his head, centred between the end of the words and
     the photo (motion/tiles.ts measures and places it; the values here are the fallback). They scatter in from there,
     and pointing at any of them scatters them again. */
  @media (min-width: 1024px) {
    .finale__cluster {
      --tile: clamp(52px, 4.6vw, 68px);
      inset: auto;
      right: 36%;
      top: 26%;
      display: grid;
      grid-template-columns: repeat(4, var(--tile));
      gap: clamp(10px, 1vw, 16px);
    }
    .finale__s, .finale__s--3, .finale__s--4, .finale__s--8 { display: block; position: static; width: var(--tile); pointer-events: auto; }
    .finale__s--1 { width: var(--tile); }
  }
  @keyframes finale-bob { from { translate: 0 0; } to { translate: 0 -12px; } }
  @media (prefers-reduced-motion: reduce) { .finale__s { animation: none; } }
</style>
