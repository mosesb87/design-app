---
// The contact finale on every page: "Put yours in place." — a cobalt room, the email big enough to tap,
// one-click copy, and the other ways to reach Mousa. (Copy behaviour: scripts/motion/contact.ts.)
import Sticker from './play/Sticker.astro';
import { person } from '../data/site';
interface Props { heading?: string }
const { heading } = Astro.props;
---
<section class="finale" id="contact" data-ground="red" aria-labelledby="contact-title" data-contact>
  <div class="finale__room">
    <div class="finale__glow" aria-hidden="true"></div>
    <div class="wrap finale__inner">
      <p class="kicker finale__kicker">Contact</p>
      <h2 class="finale__title" id="contact-title">{heading ?? <>Put yours<br />in place.</>}</h2>
      <p class="finale__sub">{person.contactLine} {person.contactSub}</p>

      <div class="finale__email-row">
        <a class="finale__email" href={`mailto:${person.email}`} data-email>{person.email}</a>
        <div class="finale__actions">
          <button class="btn btn--bright finale__copy" type="button" data-copy={person.email}>
            <span data-copy-label>Copy email</span>
          </button>
          <span class="finale__stamp" role="status" aria-live="polite" data-copy-status></span>
        </div>
      </div>

      <dl class="finale__ledger">
        <div><dt>Phone</dt><dd><a href={person.phoneHref}>{person.phoneDisplay}</a></dd></div>
        <div><dt>LinkedIn</dt><dd><a href={person.linkedin} rel="noopener">{person.linkedinLabel} <span aria-hidden="true">↗</span></a></dd></div>
        <div><dt>Based in</dt><dd>{person.location} · {person.region}</dd></div>
      </dl>
    </div>
    <span class="finale__s finale__s--1" aria-hidden="true"><Sticker name="heart" tilt={-6} /></span>
    <span class="finale__s finale__s--2" aria-hidden="true"><Sticker name="spark" tilt={10} /></span>
    <span class="finale__s finale__s--3" aria-hidden="true"><Sticker name="check" tilt={8} /></span>
    <span class="finale__s finale__s--4" aria-hidden="true"><Sticker name="cursor" tilt={-6} /></span>
  </div>
</section>

<style>
  .finale { padding: var(--s-8) clamp(8px, 1.4vw, 24px) 10px; }
  .finale__room {
    position: relative;
    overflow: clip;
    border-radius: var(--r-xl);
    background: radial-gradient(120% 120% at 85% 0%, #3a5bf0 0%, var(--accent) 40%, var(--accent-deep) 100%);
    color: #fff;
    padding-block: clamp(48px, 6vw, 88px) clamp(36px, 4vw, 56px);
  }
  .finale__glow {
    position: absolute;
    left: -10%;
    right: -10%;
    bottom: -35%;
    height: 70%;
    background: var(--spectrum);
    background-size: 200% 100%;
    filter: blur(90px);
    opacity: 0.35;
    border-radius: 50%;
    animation: finale-drift 16s linear infinite;
    pointer-events: none;
  }
  @keyframes finale-drift { to { background-position: 200% 0; } }
  .finale__inner { position: relative; z-index: 2; display: grid; gap: var(--s-4); }
  .finale__kicker { background: rgb(255 255 255 / 0.14); color: #fff; }
  .finale__title { font-family: var(--font-display); font-weight: 900; font-stretch: 75%; font-size: clamp(3rem, 7vw, 6.75rem); line-height: 0.86; text-transform: uppercase; max-width: 12ch; }
  .finale__sub { font-size: var(--t-lead); line-height: 1.3; max-width: 36ch; color: #e6ebff; font-weight: 500; }
  .finale__email-row { container-type: inline-size; display: flex; flex-wrap: wrap; align-items: center; gap: var(--s-4) var(--s-5); margin-top: var(--s-4); }
  .finale__email {
    justify-self: start;
    font-family: var(--font-display);
    font-weight: 900;
    font-stretch: 80%;
    font-size: min(clamp(1.5rem, 3.4vw, 3.25rem), calc(100cqi / 12.6));
    line-height: 1.1;
    color: #fff;
    text-decoration: none;
    background: linear-gradient(transparent 90%, rgb(255 255 255 / 0.45) 0) left / 100% 100% no-repeat;
    overflow-wrap: anywhere;
  }
  .finale__email:hover { color: #dfe5ff; background-image: linear-gradient(transparent 90%, #fff 0); }
  .finale__copy { --btn-bg: #fff; --btn-fg: var(--ink); }
  .finale__actions { display: flex; align-items: center; gap: var(--s-5); flex-wrap: wrap; }
  .finale__stamp:empty { display: none; }
  .finale__stamp { display: inline-block; padding: 10px 16px; border-radius: var(--r-pill); background: var(--orange); color: var(--ink); font: 750 0.9375rem/1 var(--font-text); }
  .finale__ledger {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 10px var(--gutter);
    margin-top: var(--s-5);
  }
  .finale__ledger div { padding: 12px 16px; border-radius: var(--r-m); background: rgb(255 255 255 / 0.1); }
  .finale__ledger dt { font: 700 var(--t-slug) / 1.3 var(--font-text); letter-spacing: 0.06em; text-transform: uppercase; color: #dfe5ff; margin-bottom: 6px; }
  .finale__ledger dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  .finale__ledger a { color: #fff; text-decoration-color: color-mix(in srgb, #fff 45%, transparent); }
  .finale__s { position: absolute; z-index: 1; pointer-events: none; animation: finale-bob 3.4s ease-in-out infinite alternate; }
  .finale__s :global(.sticker) { --size: 100%; width: 100%; }
  .finale__s--1 { width: clamp(56px, 6vw, 96px); right: 6%; top: 8%; }
  .finale__s--2 { width: clamp(40px, 4vw, 64px); right: 22%; top: 6%; animation-delay: -1.2s; }
  .finale__s--3 { width: clamp(48px, 5vw, 80px); right: 12%; bottom: 14%; animation-delay: -2s; display: none; }
  .finale__s--4 { width: clamp(40px, 4vw, 64px); right: 30%; bottom: 30%; animation-delay: -0.6s; display: none; }
  /* Bottom stickers only where the ledger leaves them room */
  @media (min-width: 1024px) { .finale__s--1 { top: 12%; } .finale__s--2 { top: 10%; right: 20%; } .finale__s--3, .finale__s--4 { display: block; } .finale__s--3 { bottom: 38%; } .finale__s--4 { right: 26%; bottom: 44%; } }
  @keyframes finale-bob { from { transform: translateY(0); } to { transform: translateY(-10px); } }
  @media (prefers-reduced-motion: reduce) { .finale__glow, .finale__s { animation: none; } }
</style>
