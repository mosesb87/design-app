---
// The archive table — the most crafted utility on the site. Rows open the case study (→) or the live thing (↗).
// Desktop: a proof loupe previews each row's capture. Touch: inline thumbnails. Keyboard: the loupe follows focus.
import { entries as all, statusLabel, categories, type Entry } from '../data/work';
import { view, pick } from '../lib/media';
interface Props { limit?: number; filters?: boolean; id?: string }
const { limit, filters = false, id = 'index' } = Astro.props;

// Parents first, their family rows right after them.
const parents = all.filter((e) => !e.family);
const ordered: (Entry & { child: boolean })[] = [];
for (const p of parents) {
  ordered.push({ ...p, child: false });
  for (const c of all.filter((e) => e.family === p.slug)) ordered.push({ ...c, child: true });
}
const rows = limit ? ordered.filter((e) => !e.child).slice(0, limit) : ordered;
const catLabel = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const counts = Object.fromEntries(categories.map((c) => [c.id, all.filter((e) => e.category === c.id).length]));
const preview = (e: Entry) => {
  const d = view(e.media, 'desktop-hero');
  return d ? pick(d.webp, 960).src : '';
};
const thumb = (e: Entry) => {
  const d = view(e.media, 'desktop-hero');
  return d ? pick(d.webp, 480).src : '';
};
---
<div class="index" data-loupe id={id}>
  {filters && (
    <div class="index__filters" role="group" aria-label="Filter the archive" data-filter>
      <button type="button" class="chip" aria-pressed="true" data-filter-value="all">All <span class="num">{all.length}</span></button>
      {categories.map((c) => (
        <button type="button" class="chip" aria-pressed="false" data-filter-value={c.id}>{c.label} <span class="num">{counts[c.id]}</span></button>
      ))}
      <p class="visually-hidden" role="status" aria-live="polite" data-filter-status></p>
    </div>
  )}
  <table class="index__table">
    <caption class="visually-hidden">Every project, tool, case study, review and proposal, with what it is and where it lives.</caption>
    <thead>
      <tr>
        <th scope="col" class="index__c-n">No.</th>
        <th scope="col">Project</th>
        <th scope="col" class="index__c-what">What it is</th>
        <th scope="col" class="index__c-plat">Platform</th>
        <th scope="col" class="index__c-status">Status</th>
      </tr>
    </thead>
    <tbody data-rows-body>
      {rows.map((e, i) => {
        const href = e.caseStudy ? `/work/${e.caseStudy}/` : e.url;
        const internal = !!e.caseStudy;
        const n = String(i + 1).padStart(2, '0');
        return (
          <tr class:list={['index__row', { 'is-child': e.child, 'has-case': internal }]} data-cat={e.category} data-preview={preview(e) || undefined} data-row>
            <td class="index__c-n num slug">{e.child ? '—' : n}</td>
            <th scope="row" class="index__c-title">
              {href ? (
                <a href={href} rel={internal ? undefined : 'noopener'} data-vt-plate={internal ? '' : undefined}>
                  <span class="index__title-text">{e.title}</span>
                  <span class="index__arrow" aria-hidden="true">{internal ? '→' : '↗'}</span>
                  <span class="visually-hidden">{internal ? ' — case study' : ' — opens the live site'}</span>
                </a>
              ) : (
                <span class="index__title-text">{e.title}</span>
              )}
              {thumb(e) && <img class="index__thumb" src={thumb(e)} alt="" aria-hidden="true" loading="lazy" decoding="async" width="480" height="300" />}
            </th>
            <td class="index__c-what">{e.what}</td>
            <td class="index__c-plat slug">{[catLabel[e.category], e.platform, e.languages?.join(' + ')].filter(Boolean).join(' · ')}</td>
            <td class="index__c-status slug"><span class:list={['status', `status--${e.status}`]}>{statusLabel[e.status]}</span></td>
          </tr>
        );
      })}
    </tbody>
  </table>
  <div class="loupe" aria-hidden="true" data-loupe-lens><img alt="" data-loupe-img /></div>
</div>

<style>
  .index { position: relative; }
  .index__filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: var(--s-6); }
  .chip {
    min-height: 44px;
    padding: 0 14px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid var(--line);
    font: 500 0.8125rem/1 var(--font-mono);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    transition: background-color var(--d-micro), color var(--d-micro), border-color var(--d-micro), box-shadow var(--d-small) var(--ease-register);
  }
  .chip .num { color: var(--fg-2); font-size: 0.72rem; }
  .chip:hover { border-color: var(--fg); }
  .chip[aria-pressed='true'] { background: var(--fg); color: var(--bg); border-color: var(--fg); box-shadow: -3px 3px 0 var(--sheet), 3px -3px 0 var(--register); }
  .chip[aria-pressed='true'] .num { color: inherit; opacity: 0.7; }

  .index__table { width: 100%; border-top: 1px solid var(--fg); }
  .index__table thead th { text-align: left; font: 500 var(--t-slug) / 1.4 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--fg-2); padding: 10px 12px 10px 0; border-bottom: 1px solid var(--line); }
  .index__row td, .index__row th { padding: 16px 12px 16px 0; border-bottom: 1px solid var(--line); vertical-align: top; text-align: left; font-weight: inherit; }
  .index__row { transition: background-color var(--d-micro); }
  .index__c-n { width: 3.5em; color: var(--fg-2); }
  .index__c-title a { display: inline-flex; align-items: baseline; gap: 0.35em; text-decoration: none; min-height: 32px; }
  .index__title-text {
    font-family: var(--font-display);
    font-weight: 740;
    font-stretch: 100%;
    font-size: clamp(1.2rem, 1.8vw, 1.65rem);
    line-height: 1.1;
    letter-spacing: -0.015em;
    transition: font-stretch var(--d-small) var(--ease-register);
  }
  .index__arrow { color: var(--fg-2); transition: transform var(--d-small) var(--ease-register), color var(--d-micro); }
  .index__row:hover .index__title-text, .index__row:focus-within .index__title-text { font-stretch: 112%; }
  .index__row:hover .index__arrow, .index__row:focus-within .index__arrow { transform: translate(3px, -2px); color: var(--sheet); }
  .index__row:hover, .index__row:focus-within { background: color-mix(in srgb, var(--paper-2) 70%, transparent); }
  .is-child .index__title-text { font-size: clamp(1rem, 1.3vw, 1.2rem); font-weight: 620; }
  .is-child .index__c-title { padding-left: 1.2em; }
  .index__c-what { color: var(--fg-2); max-width: 46ch; font-size: var(--t-small); }
  .index__c-plat, .index__c-status { white-space: normal; }
  .status { display: inline-block; }
  .status--demo, .status--adaptation, .status--independent { color: var(--register-text); }
  .status--login, .status--unverified { color: var(--fg-2); }
  .index__thumb { display: none; }

  .loupe {
    position: fixed;
    left: 0;
    top: 0;
    width: min(34vw, 460px);
    aspect-ratio: 16 / 10;
    pointer-events: none;
    z-index: 40;
    clip-path: circle(0% at 50% 50%);
    background: var(--paper-2);
    box-shadow: -6px 6px 0 var(--sheet), 6px -6px 0 var(--register);
    will-change: transform, clip-path;
  }
  .loupe img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }

  /* Narrow screens: rows become cards with inline thumbnails (no hover on touch). */
  @media (max-width: 899px) {
    .index__table, .index__table tbody, .index__row, .index__row > * { display: block; }
    .index__table thead { display: none; }
    .index__row { display: grid; grid-template-columns: 2.5em 1fr; column-gap: 8px; padding-block: 14px; border-bottom: 1px solid var(--line); }
    .index__row td, .index__row th { padding: 0; border: 0; }
    .index__c-n { grid-row: span 4; }
    .index__c-what { margin-top: 6px; }
    .index__c-plat, .index__c-status { margin-top: 6px; }
    .index__thumb { display: block; width: 100%; max-width: 360px; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; margin-top: 10px; background: var(--paper-2); }
    .loupe { display: none; }
  }
  @media (min-width: 900px) and (max-width: 1199px) { .index__c-plat { display: none; } }
  :global(.pointer-coarse) .loupe { display: none; }
</style>
