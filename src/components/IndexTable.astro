---
// The archive index, compact: on desktop every entry is a name in one running wall of names (grouped work
// right after its parent, smaller, with a +). Each name carries its number, a Case study badge where there is
// one, and its status when it isn't simply live (demo, fictional company, independent…). Pointing at a name
// dims the rest and opens a browser window with the project scrolling inside it, and a caption: what it is,
// platform, status. Phones and touch screens get compact rows with the description (and, on tablets, the
// screenshot). What each entry is stays in the page for screen readers and search in every layout.
// Motion: scripts/motion/loupe.ts (preview), reveals.ts (names rise in sequence), filter.ts (filters).
import { entries as all, statusLabel, categories, type Entry } from '../data/work';
import { allReviews } from '../data/reviews';
import { view, pick } from '../lib/media';
interface Props { limit?: number; filters?: boolean; id?: string }
const { limit, filters = false, id = 'index' } = Astro.props;

// Parents first, their family entries right after them.
const parents = all.filter((e) => !e.family);
const ordered: (Entry & { child: boolean })[] = [];
for (const p of parents) {
  ordered.push({ ...p, child: false });
  for (const c of all.filter((e) => e.family === p.slug)) ordered.push({ ...c, child: true });
}
const rows = limit ? ordered.filter((e) => !e.child).slice(0, limit) : ordered;
const catLabel = Object.fromEntries(categories.map((c) => [c.id, c.label]));
const counts = Object.fromEntries(categories.map((c) => [c.id, all.filter((e) => e.category === c.id).length]));
// Short status words for the badge; the full wording is in the caption and the description.
const shortStatus: Record<string, string> = { demo: 'Demo', login: 'Login', adaptation: 'Fictional co.', independent: 'Independent', unverified: 'Unverified' };
// Reviews without a site capture preview their own first screen.
const reviewShot = (e: Entry) => (e.category === 'reviews' ? allReviews.find((r) => `review-${r.slug}` === e.slug)?.sheets.find((x) => x.shot)?.shot : undefined);
const preview = (e: Entry) => {
  const d = view(e.media, 'desktop-hero');
  return d ? pick(d.webp, 960).src : reviewShot(e)?.small ?? '';
};
const thumb = (e: Entry) => {
  const d = view(e.media, 'desktop-hero');
  return d ? pick(d.webp, 480).src : reviewShot(e)?.small ?? '';
};
const full = (e: Entry) => {
  const d = view(e.media, 'desktop-full');
  return d ? { src: pick(d.webp, 720).src, ratio: (d.h / d.w).toFixed(4) } : undefined;
};
const host = (e: Entry) => (e.url ? (e.url.startsWith('/') ? `mousabatarseh.com${e.url}` : e.url.replace(/^https?:\/\//, '').replace(/\/$/, '')) : '');
const meta = (e: Entry) => [catLabel[e.category], e.platform, e.languages?.join(' + '), statusLabel[e.status]].filter(Boolean).join(' · ');
---
<div class="ix" data-loupe data-loupe-mode="wall" id={id}>
  {filters && (
    <div class="ix__filters" role="group" aria-label="Filter the archive" data-filter data-noun="entry,entries">
      <button type="button" class="chip" aria-pressed="true" data-filter-value="all">All <span class="num">{all.length}</span></button>
      {categories.map((c) => (
        <button type="button" class:list={['chip', `chip--${c.id}`]} aria-pressed="false" data-filter-value={c.id}>{c.label} <span class="num">{counts[c.id]}</span></button>
      ))}
      <p class="visually-hidden" role="status" aria-live="polite" data-filter-status></p>
    </div>
  )}
  <ul class="ix__wall" role="list" aria-label="Every entry" data-rows>
    {rows.map((e) => {
      const href = e.caseStudy ? `/work/${e.caseStudy}/` : e.url;
      const internal = !!e.caseStudy || !!href?.startsWith('/');
      const n = String(parents.indexOf(parents.find((p) => p.slug === e.slug)!) + 1).padStart(2, '0');
      const inner = (
        <>
          <span class="ix__dot" aria-hidden="true"></span>
          {!e.child && <span class="ix__n num" aria-hidden="true">{n}</span>}
          <span class="ix__name">{e.title}</span>
          {e.caseStudy && <span class="ix__badge ix__badge--case">Case study</span>}
          {e.status !== 'live' && <span class="ix__badge">{shortStatus[e.status]}</span>}
        </>
      );
      return (
        <li class:list={['ix__e', `ix__e--${e.category}`, { 'is-child': e.child }]} data-cat={e.category} data-preview={preview(e) || undefined} data-full={full(e)?.src} data-ratio={full(e)?.ratio} data-host={host(e) || undefined} data-title={e.title} data-what={e.what} data-meta={meta(e)} data-row>
          {href ? (
            <a class="ix__link" href={href} rel={internal ? undefined : 'noopener'} data-vt-plate={e.caseStudy ? '' : undefined}>
              {inner}
              <span class="visually-hidden">{e.caseStudy ? ' — case study' : internal ? ' — review' : ' — opens the live site'}</span>
            </a>
          ) : (
            <span class="ix__link">{inner}</span>
          )}
          <span class="ix__what">{e.what}</span>
          <span class="ix__meta">{meta(e)}</span>
          {thumb(e) && <img class="index__thumb" src={thumb(e)} alt="" aria-hidden="true" loading="lazy" decoding="async" width="480" height="300" />}
        </li>
      );
    })}
  </ul>
  <div class="loupe" aria-hidden="true" data-loupe-lens>
    <div class="loupe__bar"><span class="loupe__dots"><i></i><i></i><i></i></span><span class="loupe__url" data-loupe-url></span></div>
    <div class="loupe__view"><img alt="" data-loupe-img /></div>
    <div class="loupe__cap"><b data-loupe-title></b><span data-loupe-what></span><span class="loupe__meta" data-loupe-meta></span></div>
  </div>
</div>

<style>
  .ix { position: relative; }
  .ix__filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--s-6); }
  .chip { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border-radius: var(--r-pill); background: var(--cloud); font-weight: 650; font-size: 0.875rem; transition: background-color var(--d-small), color var(--d-small), translate 0.4s var(--ease-pop); }
  .chip::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--dot, var(--accent)); }
  .chip .num { font-size: 0.75rem; font-weight: 750; padding: 2px 7px; border-radius: 6px; background: rgb(14 17 22 / 0.08); }
  .chip:hover { translate: 0 -2px; background: var(--accent-tint-2); }
  .chip[aria-pressed='true'] { background: var(--ink); color: #fff; }
  .chip[aria-pressed='true'] .num { background: rgb(255 255 255 / 0.18); }
  .chip[aria-pressed='true']::before { background: var(--accent-soft); }

  /* A colour per category, on the chips and the entries' dots. */
  .chip--systems, .ix__e--systems { --dot: var(--accent); }
  .chip--case-studies, .ix__e--case-studies { --dot: var(--accent-deep); }
  .chip--sites, .ix__e--sites { --dot: var(--ink); }
  .chip--reviews, .ix__e--reviews { --dot: var(--blue-soft); }
  .chip--proposals, .ix__e--proposals { --dot: var(--grey-3); }

  .ix__e[hidden] { display: none !important; }
  .ix__link { color: var(--ink); text-decoration: none; }
  .ix__dot { display: inline-block; width: 0.22em; height: 0.22em; margin-right: 0.28em; border-radius: 50%; background: var(--dot); vertical-align: 0.32em; }
  .ix__n { font: 700 0.6875rem / 1 var(--font-text); letter-spacing: 0.04em; vertical-align: super; margin-right: 0.35em; color: var(--ink-2); }
  .ix__name { font-family: var(--font-display); font-weight: 900; font-stretch: 78%; text-transform: uppercase; }
  .ix__badge { display: inline-block; margin-left: 0.4em; padding: 5px 7px; border-radius: 5px; background: var(--accent-tint); color: var(--accent-deep); font: 750 0.6875rem / 1 var(--font-text); letter-spacing: 0.05em; text-transform: uppercase; vertical-align: middle; white-space: nowrap; }
  .ix__badge--case { background: var(--accent); color: #fff; }
  .index__thumb { display: none; }

  /* Phones and touch screens: compact rows — the name, what it is and the platform line. */
  .ix__wall { display: grid; gap: 6px; }
  .ix__e { display: grid; gap: 4px; padding: 12px 14px; border-radius: var(--r-m); background: var(--cloud); transition: background-color var(--d-small); }
  .ix__e.is-child { margin-left: 18px; background: color-mix(in srgb, var(--cloud) 50%, #fff); }
  .ix__e .ix__link { display: block; padding-block: 5px; font-size: clamp(1.15rem, 4.6vw, 1.4rem); line-height: 1.05; }
  .ix__what { font-size: var(--t-small); font-weight: 500; color: var(--ink-2); }
  .ix__meta { font: 650 0.75rem / 1.4 var(--font-text); letter-spacing: 0.02em; text-transform: uppercase; color: var(--ink-2); }
  .ix__e:hover { background: var(--accent-tint); }

  @media (min-width: 900px) {
    /* Touch screens this wide: two columns of rows, each with its screenshot. */
    :global(.pointer-coarse) .ix__wall { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    :global(.pointer-coarse) .ix__e.is-child { margin-left: 0; }
    :global(.pointer-coarse) .index__thumb { display: block; width: 100%; max-width: 280px; height: auto; aspect-ratio: 16 / 10; object-fit: cover; object-position: top; margin-top: 8px; border-radius: 6px; background: var(--night); }

    /* Desktop with a mouse: the wall. Names run on like text, divided by thin slashes; grouped entries follow
       their parent, smaller, with a +. The description and platform stay readable to screen readers and search
       only; the preview window's caption shows them on hover. */
    :global(.pointer-fine) .ix__wall { display: block; font-size: clamp(1.5rem, 2.35vw, 2.6rem); line-height: 1.14; }
    :global(.pointer-fine) .ix__e { display: inline-block; margin: 0 0 0.16em; padding: 0; gap: 0; border-radius: 0; background: none; }
    :global(.pointer-fine) .ix__e::after { content: '/'; margin: 0 0.32em 0 0.34em; color: var(--grey-3); font-family: var(--font-display); font-weight: 300; }
    :global(.pointer-fine) .ix__e .ix__link { display: inline; padding-block: 0; font-size: inherit; line-height: inherit; transition: color 0.25s, opacity 0.35s var(--ease-register); }
    :global(.pointer-fine) .ix__e.is-child { margin-left: 0; background: none; }
    :global(.pointer-fine) .ix__e.is-child .ix__link { font-size: 0.6em; color: var(--ink-2); }
    :global(.pointer-fine) .ix__e.is-child .ix__link::before { content: '+'; margin-right: 0.2em; color: var(--accent); font-weight: 800; }
    :global(.pointer-fine) .ix__e.is-child .ix__dot { display: none; }
    :global(.pointer-fine) .ix__e:hover { background: none; }
    :global(.pointer-fine) .ix__wall:has(.ix__e:hover) .ix__e:not(:hover) .ix__link { opacity: 0.22; }
    :global(.pointer-fine) .ix__e:hover .ix__link, :global(.pointer-fine) .ix__link:focus-visible { color: var(--accent); }
    :global(.pointer-fine) :is(.ix__what, .ix__meta) { position: absolute; width: 1px; height: 1px; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }

  /* The preview window: black browser chrome, the page scrolling inside, and a caption. */
  .loupe {
    position: fixed;
    left: 0;
    top: 0;
    width: min(40vw, 560px);
    pointer-events: none;
    z-index: 40;
    border-radius: 10px;
    overflow: hidden;
    background: var(--night);
    box-shadow: 0 2px 4px rgb(14 17 22 / 0.2), 0 34px 64px -24px rgb(14 17 22 / 0.6);
    opacity: 0;
    visibility: hidden;
    will-change: transform, opacity;
  }
  .loupe__bar { display: flex; align-items: center; gap: 10px; height: 30px; padding: 0 10px; }
  .loupe__dots { display: inline-flex; gap: 5px; }
  .loupe__dots i { width: 8px; height: 8px; border-radius: 50%; background: #3a414e; }
  .loupe__dots i:first-child { background: var(--accent); }
  .loupe__dots i:nth-child(2) { background: var(--accent-soft); }
  .loupe__url { flex: 1; min-width: 0; margin-inline: auto; max-width: 70%; padding: 3px 10px; border-radius: 5px; background: #1c212a; font: 500 0.75rem / 1.2 var(--font-text); color: var(--night-ink-2); text-align: center; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .loupe__view { position: relative; aspect-ratio: 16 / 10; overflow: hidden; background: var(--night-2); }
  .loupe__view img { position: absolute; left: 0; top: 0; width: 100%; height: auto; min-height: 100%; object-fit: cover; object-position: top center; will-change: transform; }
  .loupe__cap { display: grid; gap: 4px; padding: 12px 14px 14px; color: var(--night-ink); }
  .loupe__cap b { font-family: var(--font-display); font-weight: 900; font-stretch: 78%; font-size: 1.35rem; line-height: 1; text-transform: uppercase; }
  .loupe__cap span { font-size: 0.875rem; line-height: 1.4; color: var(--night-ink-2); }
  .loupe__cap .loupe__meta { font: 650 0.6875rem / 1.4 var(--font-text); letter-spacing: 0.04em; text-transform: uppercase; color: var(--accent-soft); }
  :global(.pointer-coarse) .loupe { display: none; }
  @media (max-width: 899px) { .loupe { display: none; } }
</style>
