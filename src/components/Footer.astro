---
// The footer: a plain line on the white page under the black contact block — the logo and name, the pages,
// back to top, then one small line of provenance. No background, no icon buttons (Mousa, round 4).
import { person, nav } from '../data/site';
import Logo from './Logo.astro';
const built = new Date().toISOString().slice(0, 10);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__bar wrap">
    <a class="footer__brand" href="/"><Logo size={22} /><span>{person.name}</span></a>
    <nav class="footer__nav" aria-label="Footer">
      {nav.filter((n) => n.href !== '/').map((n) => <a href={n.href}>{n.label}</a>)}
      <a href="/index/">The index</a>
      <a href="#top" class="footer__top">Back to top <span aria-hidden="true">↑</span></a>
    </nav>
  </div>
  <p class="footer__meta wrap">
    <span>© {year} {person.name} · {person.location}</span>
    <span>Built {built}</span>
    <!-- Replaced after the build with this page's measured weight (scripts/postbuild.mjs). -->
    <span data-weight>This page: measured at build</span>
    <span>Hubot Sans &amp; Mona Sans (SIL OFL)</span>
  </p>
</footer>

<style>
  .footer { display: grid; gap: 10px; padding: clamp(18px, 2vw, 28px) 0 clamp(20px, 2.4vw, 32px); color: var(--ink); }
  .footer__bar { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 20px; }
  .footer__brand { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-right: auto; color: var(--ink); text-decoration: none; font-family: var(--font-display); font-weight: 900; font-stretch: 75%; font-size: 1.125rem; text-transform: uppercase; letter-spacing: 0.01em; transition: font-stretch 0.5s var(--ease-register); }
  .footer__brand :global(svg) { transition: transform 0.6s var(--ease-pop); }
  .footer__brand:hover { font-stretch: 100%; }
  .footer__brand:hover :global(svg) { transform: scale(1.14); }
  .footer__nav { display: flex; flex-wrap: wrap; gap: 2px; }
  .footer__nav a { display: inline-flex; align-items: center; gap: 6px; min-height: 40px; padding: 0 12px; border-radius: var(--r-pill); color: var(--ink); font: 600 0.9375rem / 1 var(--font-text); text-decoration: none; transition: background-color var(--d-small), color var(--d-small), translate 0.4s var(--ease-register); }
  .footer__nav a:hover { background: var(--accent-tint); color: var(--accent-deep); translate: 0 -2px; }
  .footer__top span { transition: translate 0.4s var(--ease-pop); }
  .footer__top:hover span { translate: 0 -3px; }
  .footer__meta { display: flex; flex-wrap: wrap; gap: 2px 16px; font: 500 0.75rem / 1.5 var(--font-text); color: var(--ink-2); }
  .footer__meta span { transition: color var(--d-small); }
  .footer__meta span:hover { color: var(--ink); }
</style>
