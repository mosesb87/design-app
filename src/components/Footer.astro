---
// The footer: one slim night strip — the logo and name, the pages, the email in orange, back to top — over a slow
// cobalt-and-orange glow; then one small line of provenance.
import { person, nav } from '../data/site';
import Logo from './Logo.astro';
const built = new Date().toISOString().slice(0, 10);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__room">
    <div class="footer__glow" aria-hidden="true"></div>
    <div class="footer__row">
      <a class="footer__brand" href="/"><Logo size={22} /><span>{person.name}</span></a>
      <nav class="footer__nav" aria-label="Footer">
        {nav.filter((n) => n.href !== '/').map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <a class="footer__mail" href={`mailto:${person.email}`}>{person.email}</a>
      <a href="#top" class="footer__top">Top <span aria-hidden="true">↑</span></a>
    </div>
    <p class="footer__meta">
      <span>© {year} {person.name} · {person.location}</span>
      <span>Built {built}</span>
      <!-- Replaced after the build with this page's measured weight (scripts/postbuild.mjs). -->
      <span data-weight>This page: measured at build</span>
      <span>Hubot Sans &amp; Mona Sans (SIL OFL)</span>
    </p>
  </div>
</footer>

<style>
  .footer { padding: 0 clamp(8px, 1.4vw, 24px) clamp(8px, 1.4vw, 24px); }
  .footer__room {
    position: relative;
    overflow: clip;
    isolation: isolate;
    display: grid;
    gap: 14px;
    padding: 18px clamp(16px, 2.4vw, 32px) 16px;
    border-radius: var(--r-l);
    background: var(--night);
    color: var(--night-ink);
    --focus: var(--orange);
  }
  .footer__glow {
    position: absolute;
    inset: -60% -10% auto;
    height: 220%;
    z-index: -1;
    background: radial-gradient(40% 40% at 20% 50%, rgb(43 77 224 / 0.45), transparent 70%), radial-gradient(35% 45% at 80% 50%, rgb(255 122 26 / 0.35), transparent 70%);
    animation: footer-drift 18s var(--ease-drift) infinite alternate;
    pointer-events: none;
  }
  @keyframes footer-drift { to { transform: translateX(8%) scale(1.08); } }
  .footer__row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 20px; }
  .footer__brand { display: inline-flex; align-items: center; gap: 10px; min-height: 40px; margin-right: auto; color: #fff; text-decoration: none; font-family: var(--font-display); font-weight: 900; font-stretch: 75%; font-size: 1.125rem; text-transform: uppercase; letter-spacing: 0.01em; }
  .footer__nav { display: flex; flex-wrap: wrap; gap: 2px; }
  .footer__nav a { display: inline-flex; align-items: center; min-height: 36px; padding: 0 12px; border-radius: var(--r-pill); color: var(--night-ink); font: 600 0.875rem / 1 var(--font-text); text-decoration: none; transition: background-color var(--d-small), color var(--d-small); }
  .footer__nav a:hover { background: rgb(255 255 255 / 0.1); color: #fff; }
  .footer__mail { display: inline-flex; align-items: center; min-height: 36px; padding: 0 14px; border-radius: var(--r-pill); background: var(--orange); color: var(--ink); font: 700 0.875rem / 1 var(--font-text); text-decoration: none; transition: transform var(--d-small) var(--ease-register); }
  .footer__mail:hover { transform: translateY(-2px); }
  .footer__top { display: inline-grid; place-items: center; min-width: 36px; min-height: 36px; padding: 0 12px; border-radius: var(--r-pill); background: #fff; color: var(--ink); font: 700 0.8125rem / 1 var(--font-text); text-decoration: none; }
  .footer__meta { display: flex; flex-wrap: wrap; gap: 2px 16px; font: 500 0.75rem / 1.5 var(--font-text); color: var(--night-ink-2); }
  @media (prefers-reduced-motion: reduce) { .footer__glow { animation: none; } }
</style>
