---
// The footer finishes the contact block's black room (or stands alone where a page has no contact block): the
// logo and name, the pages, three coloured contact buttons (email, LinkedIn, phone) and back to top, then one
// small line of provenance.
import { person, nav } from '../data/site';
import Logo from './Logo.astro';
const built = new Date().toISOString().slice(0, 10);
const year = new Date().getFullYear();
---
<footer class="footer">
  <div class="footer__room">
    <div class="footer__bar">
      <a class="footer__brand" href="/"><Logo size={24} /><span>{person.name}</span></a>
      <nav class="footer__nav" aria-label="Footer">
        {nav.filter((n) => n.href !== '/').map((n) => <a href={n.href}>{n.label}</a>)}
      </nav>
      <div class="footer__reach">
        <a class="footer__ic footer__ic--mail" href={`mailto:${person.email}`} aria-label={`Email ${person.email}`} title={person.email}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2.5" /><path d="M4 7.5l8 6 8-6" /></svg>
        </a>
        <a class="footer__ic footer__ic--in" href={person.linkedin} rel="noopener" aria-label="LinkedIn" title="LinkedIn">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="3.5" /><path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5M11.5 13c0-1.6 1-2.6 2.4-2.6s2.1 1 2.1 2.6V16" /></svg>
        </a>
        <a class="footer__ic footer__ic--tel" href={person.phoneHref} aria-label={`Call ${person.phoneDisplay}`} title={person.phoneDisplay}>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 3.5h3l1.5 4-2 1.5a11 11 0 0 0 6 6l1.5-2 4 1.5v3a2 2 0 0 1-2 2A16.5 16.5 0 0 1 4.5 5.5a2 2 0 0 1 2-2z" /></svg>
        </a>
        <a class="footer__ic footer__ic--top" href="#top" aria-label="Back to top" title="Back to top">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
        </a>
      </div>
    </div>
    <p class="footer__meta">
      <span>© {year} {person.name} · {person.location}</span>
      <span>Built {built}</span>
      <!-- Replaced after the build with this page's measured weight (scripts/postbuild.mjs). -->
      <span data-weight>This page: measured at build</span>
      <span>Hubot Sans &amp; Mona Sans (SIL OFL)</span>
    </p>
  </div>
</footer>

<style>
  .footer { padding: 0 clamp(8px, 1.4vw, 24px) clamp(8px, 1.4vw, 24px); }
  .footer__room {
    display: grid;
    gap: 14px;
    padding: clamp(14px, 1.6vw, 20px) clamp(14px, 1.6vw, 20px) 16px;
    border-radius: var(--r-xl);
    background: var(--night);
    color: var(--night-ink);
    --focus: var(--accent-soft);
  }
  /* Under the contact block the two read as one black room. */
  :global(.finale) + .footer .footer__room { border-radius: 0 0 var(--r-xl) var(--r-xl); padding-top: 0; }
  .footer__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 20px;
    padding: 10px 10px 10px 18px;
    border-radius: var(--r-l);
    background: var(--night-2);
  }
  .footer__brand { display: inline-flex; align-items: center; gap: 10px; min-height: 44px; margin-right: auto; color: #fff; text-decoration: none; font-family: var(--font-display); font-weight: 900; font-stretch: 75%; font-size: 1.25rem; text-transform: uppercase; letter-spacing: 0.01em; transition: font-stretch 0.5s var(--ease-register); }
  .footer__brand :global(svg) { transition: transform 0.6s var(--ease-pop); }
  .footer__brand:hover { font-stretch: 100%; }
  .footer__brand:hover :global(svg) { transform: scale(1.14); }
  .footer__nav { display: flex; flex-wrap: wrap; gap: 2px; }
  .footer__nav a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; border-radius: var(--r-pill); color: var(--night-ink); font: 600 0.9375rem / 1 var(--font-text); text-decoration: none; transition: background-color var(--d-small), color var(--d-small), translate 0.4s var(--ease-register); }
  .footer__nav a:hover { background: var(--accent); color: #fff; translate: 0 -2px; }
  .footer__reach { display: flex; gap: 8px; }
  /* Coloured round buttons: cobalt, sky, white; back to top in cobalt outline. */
  .footer__ic { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; text-decoration: none; transition: transform 0.45s var(--ease-pop), background-color var(--d-small), color var(--d-small); }
  .footer__ic svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .footer__ic--mail { background: var(--accent); color: #fff; }
  .footer__ic--in { background: var(--accent-soft); color: var(--ink); }
  .footer__ic--tel { background: #fff; color: var(--ink); }
  .footer__ic--top { background: transparent; color: #fff; box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.35); }
  .footer__ic:hover { transform: translateY(-3px) rotate(-8deg) scale(1.08); }
  .footer__ic--top:hover { transform: translateY(-4px); background: var(--accent); box-shadow: none; }
  .footer__meta { display: flex; flex-wrap: wrap; gap: 2px 16px; padding-inline: 8px; font: 500 0.75rem / 1.5 var(--font-text); color: var(--night-ink-2); }
  .footer__meta span { transition: color var(--d-small); }
  .footer__meta span:hover { color: #fff; }
</style>
