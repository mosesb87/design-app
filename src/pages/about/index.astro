---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/play/PageHead.astro';
import { person, method, workflow, services, skills, toolGroups, courses, CHECKED } from '../../data/site';
import { SITE_URL } from '../../data/site';
const jsonLd = [{ '@type': 'ProfilePage', '@id': `${SITE_URL}/about/#page`, url: `${SITE_URL}/about/`, mainEntity: { '@id': `${SITE_URL}/#person` } }];
---
<Base title="About" description={`About ${person.name}: seven years building and running WordPress sites and e-commerce stores — product data, SEO, operations and the tools that check them. Warren, Michigan.`} path="/about/" og="about" type="profile" jsonLd={jsonLd}>
  <PageHead title="From fragile to boring." kicker="About · Warren, Michigan" dot="var(--lime)" lead="In the best way." stickers={['heart', 'cursor', 'cell']} />

  <section class="about__intro section wrap" aria-labelledby="intro-title">
    <h2 class="visually-hidden" id="intro-title">Who I am</h2>
    <div class="about__prose">
      {person.about.map((p) => <p>{p}</p>)}
    </div>
    <dl class="about__ledger" data-pop-grid>
      <div style="--bg: var(--lilac)" data-pop><dt>Based in</dt><dd>{person.location} · {person.region}</dd></div>
      <div style="--bg: var(--lemon)" data-pop><dt>Experience</dt><dd>Seven years · WordPress since {person.wordpressSince}</dd></div>
      <div style="--bg: var(--mint)" data-pop><dt>Platforms</dt><dd>{[...person.platforms, ...person.builders].join(' · ')}</dd></div>
      <div style="--bg: var(--sky)" data-pop><dt>Languages</dt><dd>{person.languages.join(' · ')}</dd></div>
    </dl>
  </section>

  <section class="about__method section wrap" aria-labelledby="method-title">
    <header class="about__head">
      <p class="kicker" style="--kicker-dot: var(--violet)">Method</p>
      <h2 class="h2" id="method-title">Four steps, every single time.</h2>
    </header>
    <ol class="method" role="list" data-pop-grid>
      {method.map((m, i) => (
        <li style={`--bg:${['var(--pink)', 'var(--lime)', 'var(--sun)', 'var(--aqua)'][i % 4]}`} data-pop><span class="method__n num">{m.n}</span><h3 class="method__title">{m.title}</h3><p class="method__text">{m.text}</p></li>
      ))}
    </ol>
  </section>

  <section class="about__workflow section section--tight wrap" aria-labelledby="workflow-title">
    <header class="about__head">
      <p class="kicker" style="--kicker-dot: var(--aqua)">Workflow</p>
      <h2 class="h2" id="workflow-title">Eleven steps, goal to measurement.</h2>
    </header>
    <ol class="workflow" role="list">
      {workflow.map(([t, d], i) => (
        <li><span class="workflow__n num">{String(i + 1).padStart(2, '0')}</span><span class="workflow__t">{t}</span><span class="workflow__d">{d}</span></li>
      ))}
    </ol>
  </section>

  <section class="about__services section wrap" aria-labelledby="services-title">
    <header class="about__head">
      <p class="kicker" style="--kicker-dot: var(--tomato)">Services</p>
      <h2 class="h2" id="services-title">What I do.</h2>
    </header>
    <ol class="svc" role="list">
      {services.map((s, i) => (
        <li style={`--bg:${['var(--lilac)', 'var(--mint)', 'var(--lemon)', 'var(--sky)', 'var(--peach)', 'var(--blush)'][i % 6]}`}>
          <span class="svc__n num">{s.n}</span>
          <h3 class="svc__t">{s.title}</h3>
          <p class="svc__d">{s.text}</p>
          <p class="svc__tools">{s.tools.map((t) => <span>{t}</span>)}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="about__skills section wrap" aria-labelledby="skills-title">
    <header class="about__head">
      <p class="kicker" style="--kicker-dot: var(--sun)">Skills & tools</p>
      <h2 class="h2" id="skills-title">The spec sheet.</h2>
    </header>
    <div class="skills">
      {skills.map((g) => (
        <div class="skills__group">
          <h3 class="skills__title">{g.title}</h3>
          <ul role="list">{g.items.map((it) => <li>{it}</li>)}</ul>
        </div>
      ))}
      {toolGroups.map((g) => (
        <div class="skills__group">
          <h3 class="skills__title">Tools · {g.title}</h3>
          <ul role="list">{g.items.map((it) => <li>{it}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="about__courses section wrap" aria-labelledby="courses-title">
    <header class="about__head">
      <p class="kicker" style="--kicker-dot: var(--pink)">Learning</p>
      <h2 class="h2" id="courses-title">Courses & certifications.</h2>
      <p class="about__note">As listed on my previous portfolio; issuer as stated there.</p>
    </header>
    <ul class="courses" role="list" data-pop-grid>
      {courses.map((c) => (
        <li data-pop><h3 class="courses__t">{c.title}</h3><p class="courses__i">{c.issuer}</p><p class="courses__d">{c.text}</p></li>
      ))}
    </ul>
    <p class="about__checked">Content checked {CHECKED}</p>
  </section>
</Base>

<style>
  .about__intro { display: grid; gap: var(--s-7); }
  .about__prose { display: grid; gap: 1em; font-size: var(--t-lead); line-height: 1.45; max-width: 44ch; font-weight: 450; }
  .about__ledger { display: grid; gap: 10px; align-content: start; }
  .about__ledger div { padding: 16px 18px; border-radius: var(--r-l); background: var(--bg); color: var(--ink); }
  .about__ledger dt { font: 750 var(--t-label) / 1.3 var(--font-text); text-transform: uppercase; letter-spacing: 0.05em; }
  .about__ledger dd { margin: 6px 0 0; font-weight: 650; }
  .about__head { display: grid; gap: var(--s-4); margin-bottom: var(--s-7); }
  .about__note { color: var(--fg-2); }
  .method { display: grid; gap: clamp(14px, 1.6vw, 24px); }
  .method li { display: grid; gap: 10px; align-content: start; padding: clamp(22px, 2.4vw, 32px); border-radius: var(--r-xl); background: var(--bg); color: var(--ink); }
  .method__n { justify-self: start; padding: 5px 10px; border-radius: var(--r-pill); background: var(--ink); color: #fff; font: 750 0.8125rem / 1 var(--font-text); }
  .method__title { font-family: var(--font-display); font-weight: 900; font-stretch: 75%; font-size: clamp(1.9rem, 2.6vw, 2.6rem); line-height: 0.92; text-transform: uppercase; }
  .method__text { font-weight: 500; }
  .workflow { display: grid; gap: 8px; }
  .workflow li { display: grid; grid-template-columns: auto 1fr; gap: 2px 14px; align-items: baseline; padding: 14px 18px; border-radius: var(--r-m); background: var(--cloud); }
  .workflow__n { grid-row: span 2; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--ink); color: #fff; font: 750 0.75rem / 1 var(--font-text); }
  .workflow__t { font-weight: 700; }
  .workflow__d { grid-column: 2; color: var(--ink-2); font-size: var(--t-small); }
  .svc { display: grid; gap: 12px; }
  .svc li { display: grid; gap: 8px; padding: clamp(20px, 2.2vw, 30px); border-radius: var(--r-xl); background: var(--bg); color: var(--ink); }
  .svc__n { justify-self: start; font: 750 0.8125rem / 1 var(--font-text); padding: 5px 10px; border-radius: var(--r-pill); background: #fff; }
  .svc__t { font-family: var(--font-display); font-weight: 900; font-stretch: 78%; font-size: clamp(1.75rem, 2.4vw, 2.4rem); line-height: 0.95; text-transform: uppercase; }
  .svc__d { max-width: 56ch; font-weight: 500; }
  .svc__tools { display: flex; flex-wrap: wrap; gap: 6px; }
  .svc__tools span { padding: 5px 10px; border-radius: var(--r-pill); background: rgb(255 255 255 / 0.7); font: 650 0.8125rem / 1.2 var(--font-text); }
  .skills { display: grid; gap: 12px; }
  .skills__group { padding: 20px 22px; border-radius: var(--r-l); background: var(--cloud); }
  .skills__title { font-family: var(--font-display); font-weight: 900; font-stretch: 80%; font-size: 1.4rem; line-height: 1; text-transform: uppercase; margin-bottom: 14px; }
  .skills__group ul { display: flex; flex-wrap: wrap; gap: 6px; }
  .skills__group li { padding: 6px 11px; border-radius: var(--r-pill); background: #fff; font-size: 0.875rem; font-weight: 600; }
  .courses { display: grid; gap: 12px; }
  .courses li { display: grid; gap: 6px; align-content: start; padding: 20px 22px; border-radius: var(--r-l); background: var(--cloud); }
  .courses__t { font-family: var(--font-display); font-weight: 900; font-stretch: 82%; font-size: 1.35rem; line-height: 1.05; text-transform: uppercase; }
  .courses__i { justify-self: start; padding: 4px 9px; border-radius: var(--r-pill); background: var(--lemon); font: 700 0.75rem / 1.2 var(--font-text); }
  .courses__d { color: var(--ink-2); font-size: var(--t-small); }
  .about__checked { margin-top: var(--s-6); font-size: 0.875rem; font-weight: 600; color: var(--fg-2); }
  @media (min-width: 700px) {
    .method { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .skills { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .courses { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .workflow { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .about__intro { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
    .about__prose { grid-column: 1 / span 7; }
    .about__ledger { grid-column: 9 / span 4; }
    .method { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .svc li { grid-template-columns: auto minmax(0, 1.1fr) minmax(0, 1.2fr) minmax(0, 1fr); column-gap: var(--gutter); align-items: start; }
    .svc__n { grid-column: 1; }
    .svc__t { grid-column: 2; }
    .svc__d { grid-column: 3; }
    .svc__tools { grid-column: 4; align-content: start; }
    .skills { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .courses { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
</style>
