---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/play/PageHead.astro';
import { person, method, workflow, services, skills, toolGroups, courses, degree, CHECKED, formatDate } from '../../data/site';
import Sticker from '../../components/play/Sticker.astro';
import type { StickerName } from '../../components/play/types';
// The spec sheet: skills, then tools, each group a colored card with its own icon.
const specLook: { tone: string; icon: StickerName }[] = [
  { tone: 'blue', icon: 'cell' }, { tone: 'white', icon: 'lens' }, { tone: 'night', icon: 'bag' }, { tone: 'red', icon: 'fx' }, { tone: 'sky', icon: 'check' },
  { tone: 'night', icon: 'code' }, { tone: 'iris', icon: 'chart' }, { tone: 'white', icon: 'heart' }, { tone: 'blue', icon: 'blocks' }, { tone: 'red', icon: 'bolt' },
];
const specGroups = [...skills.map((g) => ({ title: g.title, items: [...g.items] })), ...toolGroups.map((g) => ({ title: `Tools · ${g.title}`, items: [...g.items] }))]
  .map((g, i) => ({ ...g, ...specLook[i % specLook.length] }));
import { SITE_URL } from '../../data/site';
const jsonLd = [{ '@type': 'ProfilePage', '@id': `${SITE_URL}/about/#page`, url: `${SITE_URL}/about/`, mainEntity: { '@id': `${SITE_URL}/#person` } }];
// Mousa's line in three lines across the whole width (round 6); the last two words in cobalt. Phones let it wrap.
const statementLines = [['I', 'build', 'websites'], ['that', 'work,', 'then', 'I', 'make'], ['them', 'work', 'better.']];
const accentFrom = 9; // "work better." — the last two of the eleven words
---
<Base title="About" description={`About ${person.name}: seven years building and running WordPress sites and e-commerce stores — product data, SEO, operations and the tools that check them. Warren, Michigan.`} path="/about/" og="about" type="profile" jsonLd={jsonLd}>
  <PageHead title="Sites that just work." kicker="About · Warren, Michigan" lead="Reliable, predictable and quietly doing their job: that is what I build and look after." stickers={['heart', 'bag', 'chart']} />

  <section class="about__intro section wrap" aria-labelledby="intro-title">
    <h2 class="visually-hidden" id="intro-title">Who I am</h2>
    <div class="about__text">
    <div class="about__prose">
      {person.about.map((p) => <p>{p}</p>)}
    </div>
    <dl class="about__ledger" data-pop-grid>
      <div style="--bg: var(--lilac)" data-pop><dt>Based in</dt><dd>{person.location} · {person.region}</dd></div>
      <div style="--bg: var(--lemon)" data-pop><dt>Experience</dt><dd>Seven years · WordPress since {person.wordpressSince}</dd></div>
      <div style="--bg: var(--mint)" data-pop><dt>Platforms</dt><dd>{[...person.platforms, ...person.builders].join(' · ')}</dd></div>
      <div style="--bg: var(--sky)" data-pop><dt>Languages</dt><dd>{person.languages.join(' · ')}</dd></div>
    </dl>
    </div>
    <figure class="about__me" data-photo-flex>
      <div class="about__panel" aria-hidden="true" data-flex-panel></div>
      <picture class="about__photo" data-flex-photo>
        <source type="image/avif" srcset="/media/me/mousa-480.avif 480w, /media/me/mousa-800.avif 800w, /media/me/mousa-1200.avif 1200w" sizes="(min-width: 1024px) 32vw, 88vw" />
        <source type="image/webp" srcset="/media/me/mousa-480.webp 480w, /media/me/mousa-800.webp 800w, /media/me/mousa-1200.webp 1200w" sizes="(min-width: 1024px) 32vw, 88vw" />
        <img src="/media/me/mousa-800.webp" width="1200" height="1219" alt="Mousa Batarseh, smiling, arms crossed" loading="lazy" decoding="async" />
      </picture>
      <figcaption class="about__cap"><span>{person.name}</span><span>{person.location}</span></figcaption>
    </figure>
  </section>

  <!-- Mousa's line, in his words (round 6), set large: the letters fly in as it comes up the screen (fly.ts). -->
  <section class="statement wrap" aria-labelledby="statement-title">
    <h2 class="statement__t" id="statement-title" data-fly>
      <span class="visually-hidden">I build websites that work, then I make them work better.</span>
      <span aria-hidden="true">
        {statementLines.map((line, li) => (
          <span class="statement__line">
            {line.map((w, j) => {
              const k = statementLines.slice(0, li).flat().length + j;
              return <><span class:list={['statement__w', { 'statement__w--accent': k >= accentFrom }]}>{[...w].map((ch) => <span class="statement__l" data-fl>{ch}</span>)}</span>{j < line.length - 1 && ' '}</>;
            })}
            {' '}
          </span>
        ))}
      </span>
    </h2>
  </section>

  <section class="about__method section wrap" aria-labelledby="method-title">
    <header class="about__head">
      <p class="kicker">Method</p>
      <h2 class="h2" id="method-title">Four steps, every single time.</h2>
    </header>
    <ol class="method" role="list" data-pop-grid>
      {method.map((m, i) => (
        <li class:list={[{ 'is-dark': i === 3 }]} data-pop data-glow><span class="method__n num">{m.n}</span><h3 class="method__title">{m.title}</h3><p class="method__text">{m.text}</p></li>
      ))}
    </ol>
  </section>

  <section class="about__workflow section section--tight wrap" aria-labelledby="workflow-title">
    <header class="about__head">
      <p class="kicker">Workflow</p>
      <h2 class="h2" id="workflow-title">Eleven steps, goal to measurement.</h2>
    </header>
    <ol class="workflow" role="list" data-pop-grid>
      {workflow.map(([t, d], i) => (
        <li data-pop><span class="workflow__n num">{String(i + 1).padStart(2, '0')}</span><span class="workflow__t">{t}</span><span class="workflow__d">{d}</span></li>
      ))}
    </ol>
  </section>

  <section class="about__services section wrap" aria-labelledby="services-title">
    <header class="about__head">
      <p class="kicker">Services</p>
      <h2 class="h2" id="services-title">What I do.</h2>
    </header>
    <ol class="svc" role="list" data-pop-grid>
      {services.map((s, i) => (
        <li data-pop style={`--bg:${['var(--lilac)', 'var(--mint)', 'var(--lemon)', 'var(--sky)', 'var(--peach)', 'var(--blush)'][i % 6]}`}>
          <span class="svc__n num">{s.n}</span>
          <h3 class="svc__t">{s.title}</h3>
          <p class="svc__d">{s.text}</p>
          <p class="svc__tools">{s.tools.map((t) => <span>{t}</span>)}</p>
        </li>
      ))}
    </ol>
  </section>

  <section class="about__skills section wrap" aria-labelledby="skills-title">
    <header class="about__head">
      <p class="kicker">Skills & tools</p>
      <h2 class="h2" id="skills-title">The spec sheet.</h2>
    </header>
    <div class="skills" data-pop-grid>
      {specGroups.map((g, i) => (
        <article class:list={['skills__group', `skills__group--${g.tone}`]} data-pop data-glow>
          <header class="skills__head">
            <span class="skills__icon" aria-hidden="true"><Sticker name={g.icon} /></span>
            <span class="skills__count num" aria-hidden="true">{String(g.items.length).padStart(2, '0')}</span>
          </header>
          <h3 class="skills__title">{g.title}</h3>
          <ul role="list">{g.items.map((it, k) => <li style={`--k:${k}`}>{it}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section class="about__courses section wrap" aria-labelledby="courses-title">
    <header class="about__head">
      <p class="kicker">Education</p>
      <h2 class="h2" id="courses-title">Degree & certificates.</h2>
      <p class="about__note">Titles, issuers and dates as printed on each certificate. Every card opens its certificate full size.</p>
    </header>
    <div class="degree" data-glow>
      <span class="degree__icon" aria-hidden="true"><Sticker name="check" /></span>
      <div class="degree__text">
        <p class="degree__kicker">Degree · {degree.years}</p>
        <h3 class="degree__title">{degree.title} · {degree.field}</h3>
        <p class="degree__school">{degree.school} · {degree.place}</p>
      </div>
    </div>
    <ul class="courses" role="list" data-pop-grid>
      {courses.map((c) => (
        <li class:list={['cert', { 'has-cert': !!c.cert }]} data-pop>
          <div class="cert__card" data-glow>
            <h3 class="courses__t">{c.title}</h3>
            <p class="courses__i">{c.issuer}</p>
            {c.cert && <p class="courses__date"><time datetime={c.cert.date}>{formatDate(c.cert.date, 'long')}</time></p>}
            <p class="courses__d">{c.text}</p>
            {c.cert && (
              <button class="cert__peek" type="button" data-cert-open data-src={`/media/certificates/${c.cert.img}-1400.webp`} data-alt={`Certificate: ${c.title}, ${c.issuer}`}>
                <img src={`/media/certificates/${c.cert.img}-480.webp`} width="480" height={Math.round(480 * c.cert.h / c.cert.w)} alt="" loading="lazy" decoding="async" />
                <span class="visually-hidden">View the certificate: {c.title}</span>
              </button>
            )}
          </div>
          {c.cert && <span class="cert__full" aria-hidden="true"><img src={`/media/certificates/${c.cert.img}-1400.webp`} width="1400" height={Math.round(1400 * c.cert.h / c.cert.w)} alt="" loading="lazy" decoding="async" /></span>}
        </li>
      ))}
    </ul>
    <dialog class="certdlg" data-cert-dialog aria-label="Certificate">
      <form method="dialog" class="certdlg__bar"><button class="certdlg__close" type="submit">Close <span aria-hidden="true">×</span></button></form>
      <img class="certdlg__img" alt="" data-cert-img />
    </dialog>
    <p class="about__checked">Content checked {CHECKED}</p>
  </section>
</Base>

<style>
  /* Mousa's line across the whole width: three lines, the type sized so the longest ("that work, then I make")
     fills the column (container units); phones let the words wrap. */
  .statement { padding-block: var(--s-7) var(--s-8); container-type: inline-size; }
  .statement__t { font-family: var(--font-display); font-weight: 800; font-stretch: 75%; font-size: clamp(2.4rem, 12vw, 5.5rem); line-height: 0.86; letter-spacing: -0.01em; text-transform: uppercase; user-select: none; }
  .statement__line { display: inline; }
  .statement__w { display: inline-block; white-space: nowrap; }
  .statement__w--accent { color: var(--accent); }
  .statement__l { display: inline-block; transition: translate 0.35s var(--ease-register), color 0.35s; }
  @media (min-width: 700px) {
    .statement__t { font-size: min(calc(100cqi / 9.05), 16rem); }
    .statement__line { display: block; white-space: nowrap; }
  }
  @media (hover: hover) and (pointer: fine) {
    .statement__l:hover { translate: 0 -0.08em; color: var(--accent); transition-duration: 0.12s; }
    .statement__w--accent .statement__l:hover { color: var(--ink); }
  }
  .about__intro { display: grid; gap: var(--s-8); }
  .about__text { display: grid; gap: var(--s-7); align-content: start; }
  .about__me { position: relative; margin: 0; width: min(88vw, 460px); aspect-ratio: 1 / 1.12; justify-self: center; }
  .about__panel { position: absolute; inset: 16% 0 0 0; border-radius: var(--r-xl); background: radial-gradient(110% 90% at 70% 0%, #242b3a 0%, var(--night) 60%); box-shadow: var(--shadow-2); overflow: hidden; }
  .about__panel::after { content: ''; position: absolute; inset: 0; background-image: radial-gradient(rgb(255 255 255 / 0.14) 1px, transparent 1.4px); background-size: 22px 22px; mask-image: radial-gradient(80% 70% at 50% 30%, #000 10%, transparent 80%); }
  .about__photo { position: absolute; left: 0; right: 0; bottom: 0; clip-path: inset(-60% 0 0 0 round var(--r-xl)); }
  .about__photo img { width: 100%; height: auto; transition: filter 0.9s var(--ease-register); }
  @media (hover: hover) and (pointer: fine) {
    .about__photo img { filter: grayscale(1) contrast(1.06); }
    .about__me:hover .about__photo img { filter: none; }
    .about__panel, .about__photo { transition: scale 0.8s var(--ease-register); }
    .about__me:hover .about__panel { scale: 1.05; }
    .about__me:hover .about__photo { scale: 1.07; }
  }
  .about__cap { position: absolute; left: 14px; bottom: 14px; display: grid; gap: 2px; padding: 10px 14px; border-radius: var(--r-m); background: rgb(255 255 255 / 0.92); box-shadow: var(--shadow-1); font: 650 0.8125rem / 1.25 var(--font-text); }
  .about__cap span + span { font-weight: 500; color: var(--ink-2); }
  .about__prose { display: grid; gap: 1em; font-size: var(--t-lead); line-height: 1.45; max-width: 44ch; font-weight: 450; }
  .about__ledger { display: grid; gap: 10px; align-content: start; }
  .about__ledger div { padding: 16px 18px; border-radius: var(--r-l); background: var(--bg); color: var(--ink); }
  .about__ledger dt { font: 750 var(--t-label) / 1.3 var(--font-text); text-transform: uppercase; letter-spacing: 0.05em; }
  .about__ledger dd { margin: 6px 0 0; font-weight: 650; }
  .about__head { display: grid; gap: var(--s-4); margin-bottom: var(--s-7); }
  .about__note { color: var(--fg-2); }
  .method { display: grid; gap: clamp(14px, 1.6vw, 24px); }
  .method li { position: relative; display: grid; gap: 10px; align-content: start; padding: clamp(22px, 2.4vw, 32px); border-radius: var(--r-xl); background: var(--cloud); color: var(--ink); }
  .method li.is-dark { background: var(--accent); color: #fff; --glow: rgb(255 255 255 / 0.12); }
  .method li.is-dark .method__n { background: #fff; color: var(--ink); }
  .method__n { justify-self: start; padding: 5px 10px; border-radius: var(--r-pill); background: var(--ink); color: #fff; font: 750 0.8125rem / 1 var(--font-text); }
  .method__title { font-family: var(--font-display); font-weight: 650; font-stretch: 75%; font-size: var(--t-h3); line-height: 0.92; text-transform: uppercase; }
  .method__text { font-weight: 500; }
  .workflow { display: grid; gap: 8px; }
  .workflow li { display: grid; grid-template-columns: auto 1fr; gap: 2px 14px; align-items: baseline; padding: 14px 18px; border-radius: var(--r-m); background: var(--cloud); }
  .workflow__n { grid-row: span 2; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: var(--ink); color: #fff; font: 750 0.75rem / 1 var(--font-text); }
  .workflow__t { font-weight: 700; }
  .workflow__d { grid-column: 2; color: var(--ink-2); font-size: var(--t-small); }
  .svc { display: grid; gap: 12px; }
  .svc li { display: grid; gap: 8px; padding: clamp(20px, 2.2vw, 30px); border-radius: var(--r-xl); background: var(--bg); color: var(--ink); }
  .svc__n { justify-self: start; font: 750 0.8125rem / 1 var(--font-text); padding: 5px 10px; border-radius: var(--r-pill); background: #fff; }
  .svc__t { font-family: var(--font-display); font-weight: 800; font-stretch: 78%; font-size: var(--t-h3); line-height: 0.95; text-transform: uppercase; }
  .svc__d { max-width: 56ch; font-weight: 500; }
  .svc__tools { display: flex; flex-wrap: wrap; gap: 6px; }
  .svc__tools span { padding: 5px 10px; border-radius: var(--r-pill); background: rgb(255 255 255 / 0.7); font: 650 0.8125rem / 1.2 var(--font-text); }
  .skills { display: grid; gap: 12px; align-items: start; }
  .skills__group { position: relative; display: grid; gap: 12px; padding: 20px 22px 22px; border-radius: var(--r-l); background: var(--cloud); color: var(--ink); overflow: hidden; transition: translate 0.5s var(--ease-register), box-shadow 0.4s; }
  .skills__group:hover { translate: 0 -5px; box-shadow: 0 26px 48px -24px rgb(14 17 22 / 0.45); }
  .skills__head { display: flex; align-items: flex-start; justify-content: space-between; }
  .skills__icon { width: 56px; }
  .skills__icon :global(.sticker) { --size: 100%; width: 100%; }
  .skills__count { font-family: var(--font-display); font-weight: 900; font-stretch: 75%; font-size: clamp(2.5rem, 3.6vw, 3.5rem); line-height: 0.8; opacity: 0.18; transition: opacity 0.4s, scale 0.5s var(--ease-pop); transform-origin: 100% 0; }
  .skills__group:hover .skills__count { opacity: 0.5; scale: 1.1; }
  /* Tones: each card its own color, with a tile and chips that read on it. */
  .skills__group--blue { background: var(--accent); color: #fff; }
  .skills__group--white { background: #fff; box-shadow: var(--shadow-1); }
  .skills__group--night { background: var(--night); color: #fff; }
  .skills__group--leaf { background: var(--leaf-soft); }
  .skills__group--sky { background: var(--accent-tint-2); }
  .skills__group--iris { background: var(--iris); }
  .skills__group--red { background: var(--red-deep); color: #fff; }
  .about__skills .skills__group--blue .skills__icon :global(.sticker) { --tile: #fff; --stroke: var(--ink); --acc: var(--accent); }
  .about__skills .skills__group--white .skills__icon :global(.sticker) { --tile: var(--accent); --stroke: #fff; --acc: var(--blue-pale); }
  .about__skills .skills__group--night .skills__icon :global(.sticker) { --tile: var(--red); --stroke: #fff; --acc: var(--red-soft); }
  .about__skills .skills__group--leaf .skills__icon :global(.sticker) { --tile: var(--night); --stroke: #fff; --acc: var(--leaf); }
  .about__skills .skills__group--sky .skills__icon :global(.sticker) { --tile: var(--iris-deep); --stroke: #fff; --acc: var(--blue-pale); }
  .about__skills .skills__group--iris .skills__icon :global(.sticker) { --tile: #fff; --stroke: var(--ink); --acc: var(--iris-deep); }
  .about__skills .skills__group--red .skills__icon :global(.sticker) { --tile: #fff; --stroke: var(--ink); --acc: var(--red); }
  .skills__title { font-family: var(--font-display); font-weight: 650; font-stretch: 80%; font-size: var(--t-h3); line-height: 1; text-transform: uppercase; margin-bottom: 14px; }
  .skills__group ul { display: flex; flex-wrap: wrap; gap: 6px; }
  .skills__group li { padding: 6px 11px; border-radius: var(--r-pill); background: #fff; color: var(--ink); font-size: 0.875rem; font-weight: 600; transition: background-color var(--d-small), color var(--d-small), translate 0.4s var(--ease-pop); }
  .skills__group--white li { background: var(--cloud); }
  .skills__group--blue li, .skills__group--night li, .skills__group--red li { background: rgb(255 255 255 / 0.14); color: #fff; }
  .skills__group li:hover { background: var(--ink); color: #fff; translate: 0 -2px; }
  .skills__group--night li:hover, .skills__group--blue li:hover, .skills__group--red li:hover { background: #fff; color: var(--ink); }
  /* Pointing at a card sends a ripple through its chips. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .skills__group:hover li { animation: chip-wave 0.6s var(--ease-pop) both; animation-delay: calc(var(--k) * 35ms); }
  }
  @keyframes chip-wave { 40% { translate: 0 -5px; } 100% { translate: 0 0; } }
  /* More room between the certificates (Mousa, rounds 6 and 7): wide gaps between cards and rows, roomy cards. */
  .courses { display: grid; gap: clamp(32px, 4.4vw, 72px) clamp(28px, 3.6vw, 60px); }
  .cert { position: relative; }
  .cert__card { position: relative; height: 100%; overflow: hidden; display: grid; gap: 12px; align-content: start; padding: clamp(26px, 3vw, 44px) clamp(26px, 3vw, 44px) clamp(30px, 3.4vw, 48px); border-radius: var(--r-l); background: var(--cloud); }
  .has-cert .cert__card { padding-right: 38%; min-height: 250px; }
  .courses__date { font: 650 0.8125rem / 1.3 var(--font-text); color: var(--ink-2); }
  /* A quarter of the certificate peeks out of the card's corner; hovering shows the whole of it. */
  .cert__peek { position: absolute; right: -16%; bottom: -24%; width: 50%; padding: 0; border-radius: 6px; overflow: hidden; background: #fff; box-shadow: var(--shadow-2); transform: rotate(-8deg); transition: transform 0.6s var(--ease-register); cursor: zoom-in; }
  .cert__peek img { width: 100%; height: auto; }
  .cert:hover .cert__peek, .cert__peek:focus-visible { transform: rotate(-3deg) translate(-8%, -10%); }
  .cert__peek:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .cert__full { position: absolute; z-index: 30; right: 8px; bottom: calc(100% - 24px); width: min(460px, 86vw); padding: 6px; border-radius: 8px; background: var(--night); box-shadow: var(--shadow-2); opacity: 0; visibility: hidden; transform: translateY(12px) scale(0.96); transform-origin: 80% 100%; transition: opacity 0.35s var(--ease-register), transform 0.5s var(--ease-register), visibility 0s 0.35s; pointer-events: none; }
  .cert__full img { width: 100%; height: auto; border-radius: 5px; }
  @media (hover: hover) and (pointer: fine) {
    .cert:hover .cert__full { opacity: 1; visibility: visible; transform: none; transition-delay: 0.08s, 0.08s, 0s; }
  }
  .certdlg { width: min(1100px, 94vw); max-height: 92vh; padding: 8px; border: 0; border-radius: 10px; background: var(--night); color: #fff; }
  .certdlg::backdrop { background: rgb(13 16 21 / 0.72); backdrop-filter: blur(4px); }
  .certdlg__bar { display: flex; justify-content: flex-end; padding: 2px 2px 8px; }
  .certdlg__close { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border-radius: var(--r-pill); background: #fff; color: var(--ink); font-weight: 700; }
  .certdlg__img { width: 100%; height: auto; max-height: calc(92vh - 70px); object-fit: contain; border-radius: 10px; background: #fff; }
  /* The degree: one wide dark card above the certificates. */
  .degree { position: relative; display: flex; align-items: center; gap: clamp(16px, 2.4vw, 32px); margin-bottom: clamp(36px, 4.4vw, 72px); padding: clamp(20px, 2.6vw, 36px); border-radius: var(--r-l); background: var(--night); color: #fff; overflow: hidden; transition: translate 0.5s var(--ease-register), box-shadow 0.4s; }
  .degree:hover { translate: 0 -4px; box-shadow: 0 28px 50px -26px rgb(14 17 22 / 0.6); }
  .degree__icon { flex: none; width: clamp(56px, 6vw, 84px); }
  .degree__icon :global(.sticker) { --size: 100%; width: 100%; }
  .about__courses .degree__icon :global(.sticker) { --tile: var(--accent); --stroke: #fff; --acc: var(--blue-pale); background: linear-gradient(150deg, #4d6bff, var(--accent) 45%, var(--accent-deep)); box-shadow: 0 18px 36px -16px rgb(43 77 224 / 0.7); }
  .degree__text { display: grid; gap: 6px; }
