---
import Base from '../layouts/Base.astro';
import PageHead from '../components/play/PageHead.astro';
---
<Base title="Page not found" description="This page isn’t here — the link may be old or mistyped." path="/404/" og="default" contact={false} noindex>
  <div class="nf">
    <PageHead title="Nothing in this slot." kicker="Error 404" dot="var(--tomato)" lead="The link may be old or mistyped. Everything else is where it should be." stickers={['pin', 'lens', 'spark']}>
      <p class="nf__links" data-ph-fade>
        <a class="btn" href="/">Back to the home page <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--line" href="/work/">See all the work <span class="arrow" aria-hidden="true">→</span></a>
        <a class="btn btn--line" href="/blog/">Read the blog</a>
      </p>
    </PageHead>
  </div>
</Base>

<style>
  .nf { min-height: 100svh; display: grid; align-content: center; }
  .nf__links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: var(--s-3); }
</style>
