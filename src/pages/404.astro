---
import Base from '../layouts/Base.astro';
---
<Base title="Out of register" description="This page isn’t in register — the link may be old or mistyped." path="/404/" og="default" contact={false} noindex>
  <section class="nf wrap">
    <p class="kicker">Error 404</p>
    <h1 class="nf__title reg is-live" data-text="Out of register." style="--rx: -10px; --ry: -4px; --bx: 8px; --by: 5px;">Out of register.</h1>
    <p class="lead nf__lead">The sheet asked for a page the register doesn’t hold. Nothing wrong reached the shelf — you just landed between plates.</p>
    <p class="nf__links">
      <a class="btn" href="/">Back to the home page <span class="arrow" aria-hidden="true">→</span></a>
      <a class="btn btn--line" href="/work/">See all the work <span class="arrow" aria-hidden="true">→</span></a>
    </p>
  </section>
</Base>

<style>
  .nf { min-height: 100svh; display: grid; align-content: center; gap: var(--s-5); padding-top: var(--nav-h); }
  .nf__title { font-family: var(--font-display); font-size: clamp(3.5rem, 13vw, 13rem); font-weight: 860; font-stretch: 108%; line-height: 0.84; letter-spacing: -0.045em; max-width: 9ch; }
  .nf__lead { color: var(--fg-2); max-width: 36ch; }
  .nf__links { display: flex; flex-wrap: wrap; gap: var(--s-4); margin-top: var(--s-4); }
</style>
