---
// The blog, on this site: the latest post big, then every post as a bright card, filterable by topic.
import Base from '../../layouts/Base.astro';
import Sticker from '../../components/play/Sticker.astro';
import { blogPosts, categories, catKey, toneOf, dotOf, countIn } from '../../data/blog';
import { formatDate, SITE_URL } from '../../data/site';
const title = 'Blog';
const description = `${blogPosts.length} notes on WordPress, e-commerce operations, product data and SEO — written from the work of running real stores.`;
const jsonLd = [
  {
    '@type': 'Blog',
    '@id': `${SITE_URL}/blog/#blog`,
    url: `${SITE_URL}/blog/`,
    name: 'Mousa Batarseh — Blog',
    author: { '@id': `${SITE_URL}/#person` },
    blogPost: blogPosts.map((p) => ({ '@type': 'BlogPosting', headline: p.title, url: `${SITE_URL}/blog/${p.slug}/`, datePublished: p.date })),
  },
];
---
<Base title={title} description={description} path="/blog/" og="default" jsonLd={jsonLd}>
  <section class="bh wrap" aria-labelledby="blog-title">
    <p class="kicker" style="--kicker-dot: var(--tomato)">Blog · {blogPosts.length} posts</p>
    <h1 class="bh__title" id="blog-title">Notes from<br />running stores.</h1>
    <p class="bh__sub">Field notes on WordPress, e-commerce operations, product data and SEO — the things that break, and what I do about them.</p>
    <span class="bh__s bh__s--1" aria-hidden="true"><Sticker name="cell" tilt={8} /></span>
    <span class="bh__s bh__s--2" aria-hidden="true"><Sticker name="spark" tilt={-10} /></span>
  </section>

  <section class="wrap blog-list" aria-labelledby="all-title">
    <h2 class="visually-hidden" id="all-title">All posts</h2>
    <div class="chips" role="group" aria-label="Filter posts by topic" data-filter data-noun="post,posts">
      <button type="button" class="chip" aria-pressed="true" data-filter-value="all">All <span>{blogPosts.length}</span></button>
      {categories.map((c) => (
        <button type="button" class="chip" aria-pressed="false" data-filter-value={catKey(c)} style={`--dot:${dotOf(c)}`}>{c} <span>{countIn(c)}</span></button>
      ))}
      <p class="visually-hidden" role="status" aria-live="polite" data-filter-status></p>
    </div>
    <ul class="cards" role="list">
      {blogPosts.map((p, n) => (
        <li class:list={['card', { 'card--lead': n === 0 }]} data-row data-cat={p.categories.map(catKey).join(' ')} style={`--bg:${toneOf(p.categories[0])}`}>
          {p.image && <div class="card__img"><img src={n === 0 ? p.image.src : p.image.small} srcset={n === 0 ? `${p.image.small} 800w, ${p.image.src} ${p.image.w}w` : undefined} sizes={n === 0 ? '(min-width: 1100px) 56vw, 92vw' : undefined} width={n === 0 ? p.image.w : 800} height={n === 0 ? p.image.h : Math.round((p.image.h / p.image.w) * 800)} alt="" loading={n === 0 ? 'eager' : 'lazy'} fetchpriority={n === 0 ? 'high' : undefined} decoding="async" /></div>}
          <p class="post-meta">{n === 0 && <span class="tag">Latest</span>}<span>{p.categories.join(' · ')}</span><span>{formatDate(p.date)}</span></p>
          <h3 class="card__title"><a href={`/blog/${p.slug}/`}>{p.title}</a></h3>
          <p class="card__ex">{p.excerpt}</p>
          <p class="card__foot"><span>{p.minutes} min read</span><span class="card__arrow" aria-hidden="true">→</span></p>
        </li>
      ))}
    </ul>
  </section>
</Base>

<style>
  .bh { position: relative; display: grid; gap: var(--s-5); padding-top: calc(var(--nav-h) + var(--s-8)); padding-bottom: var(--s-8); }
  .bh__title { font-family: var(--font-display); font-weight: 900; font-stretch: 75%; font-size: clamp(4rem, 13vw, 13rem); line-height: 0.82; text-transform: uppercase; max-width: 9ch; }
  .bh__sub { font-size: var(--t-lead); line-height: 1.3; max-width: 40ch; color: var(--fg-2); }
  .bh__s { position: absolute; pointer-events: none; }
  .bh__s :global(.sticker) { --size: 100%; width: 100%; }
  .bh__s--1 { width: clamp(90px, 14vw, 220px); right: var(--margin); top: calc(var(--nav-h) + 40px); }
  .bh__s--2 { width: clamp(46px, 6vw, 90px); right: calc(var(--margin) + clamp(90px, 16vw, 250px)); top: calc(var(--nav-h) + 20px); }
  .post-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 14px; font: 700 var(--t-slug) / 1.4 var(--font-text); letter-spacing: 0.04em; text-transform: uppercase; }
  .tag { padding: 5px 10px; border-radius: var(--r-pill); background: var(--ink); color: #fff; }
  .blog-list { padding-block: var(--s-9) var(--s-8); display: grid; gap: var(--s-6); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: var(--r-pill); background: var(--cloud); font-weight: 650; font-size: 0.9375rem; transition: background-color var(--d-small), transform 0.4s var(--ease-pop); }
  .chip::before { content: ''; width: 9px; height: 9px; border-radius: 50%; background: var(--dot, var(--ink)); }
  .chip span { font-size: 0.75rem; font-weight: 750; padding: 2px 7px; border-radius: var(--r-pill); background: rgb(22 18 31 / 0.08); }
  .chip:hover { transform: translateY(-2px); }
  .chip[aria-pressed='true'] { background: var(--ink); color: #fff; }
  .chip[aria-pressed='true'] span { background: rgb(255 255 255 / 0.18); }
  .cards { display: grid; gap: clamp(14px, 1.6vw, 24px); }
  .card { position: relative; display: grid; gap: var(--s-4); align-content: start; padding: clamp(18px, 2vw, 28px); border-radius: var(--r-xl); background: var(--bg); color: var(--ink); transition: transform 0.5s var(--ease-pop), box-shadow var(--d-small); }
  .card:hover { transform: translateY(-6px) rotate(-0.6deg); box-shadow: var(--shadow-2); }
  .card[hidden] { display: none; }
  .card__img { border-radius: var(--r-m); overflow: hidden; aspect-ratio: 16 / 9; background: #fff; }
  .card__img img { width: 100%; height: 100%; object-fit: cover; }
  .card__title { font-family: var(--font-display); font-weight: 900; font-stretch: 78%; font-size: clamp(1.75rem, 2.4vw, 2.5rem); line-height: 0.95; text-transform: uppercase; text-wrap: balance; }
  .card__title a { text-decoration: none; }
  .card__title a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .card__ex { font-weight: 500; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 3; line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .card__foot { display: flex; justify-content: space-between; align-items: center; font: 700 var(--t-slug) / 1 var(--font-text); letter-spacing: 0.04em; text-transform: uppercase; margin-top: auto; }
  .card__arrow { display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--ink); color: #fff; font-size: 1rem; transition: transform 0.5s var(--ease-pop); }
  .card:hover .card__arrow { transform: rotate(-45deg); }
  @media (min-width: 700px) { .cards { grid-template-columns: repeat(2, minmax(0, 1fr)); } .card--lead { grid-column: 1 / -1; } .card--lead .card__title { font-size: clamp(2.5rem, 5.4vw, 4rem); line-height: 0.9; } }
  @media (min-width: 1100px) {
    .cards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .card--lead { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); grid-template-rows: 1fr auto auto auto auto 1fr; column-gap: clamp(28px, 3vw, 52px); padding: clamp(22px, 2.2vw, 34px); }
    .card--lead:hover { transform: translateY(-6px); }
    .card--lead .card__img { grid-row: 1 / -1; grid-column: 1; align-self: center; }
    .card--lead > :not(.card__img) { grid-column: 2; }
    .card--lead .post-meta { grid-row: 2; }
    .card--lead .card__title { grid-row: 3; font-size: clamp(2.75rem, 4.2vw, 4.5rem); line-height: 0.88; }
    .card--lead .card__ex { grid-row: 4; font-size: var(--t-lead); line-height: 1.35; -webkit-line-clamp: 5; line-clamp: 5; }
    .card--lead .card__foot { grid-row: 5; margin-top: var(--s-2); }
  }
</style>
