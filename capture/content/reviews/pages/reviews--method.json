      "text": "Why is every figure dated?"
    },
    {
      "t": "text",
      "tag": "summary",
      "cls": "",
      "text": "Can you review my site?"
    },
    {
      "t": "h2",
      "text": "Want one for\nyour site?"
    },
    {
      "t": "p",
      "text": "Send a URL. You’ll get the first findings back, dated and sourced."
    },
